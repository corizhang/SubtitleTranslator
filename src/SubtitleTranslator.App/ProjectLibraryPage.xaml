<UserControl x:Class="SubtitleTranslator.App.ProjectLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:SubtitleTranslator.App"
             Background="{StaticResource Brush.Surface.App}" Loaded="Page_OnLoaded">
    <UserControl.Resources>
        <Style x:Key="ProjectSummaryCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Padding" Value="18,15"/></Style>
        <Style x:Key="ProjectFactCardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource Brush.Surface.Subtle}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="4"/></Style>
        <Style x:Key="ProjectListItemStyle" TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style>
    </UserControl.Resources>

    <Grid><Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="118"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
        <Border Style="{StaticResource PageHeaderStyle}"><Grid Margin="30,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="项目库" Style="{StaticResource Text.PageTitle}"/><TextBlock Text="管理字幕项目、恢复任务并查看交付文件" Foreground="{StaticResource Brush.Text.Secondary}" Margin="22,7,0,0"/></StackPanel><Button Click="Refresh_OnClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowClockwise24"/><TextBlock Text="  刷新"/></StackPanel></Button></Grid></Border>

        <UniformGrid Grid.Row="1" Columns="4" Margin="30,16,30,14">
            <Border Style="{StaticResource ProjectSummaryCardStyle}" Margin="0,0,7,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Brush.Status.InfoSubtle}"><ui:SymbolIcon Symbol="Folder24" Foreground="{StaticResource Brush.Brand.Default}" FontSize="23"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="全部项目" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding TotalCount}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource ProjectSummaryCardStyle}" Margin="7,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Brush.Status.WarningSubtle}"><ui:SymbolIcon Symbol="Clock24" Foreground="{StaticResource Brush.Status.WarningIcon}" FontSize="23"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="可继续或恢复" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding RecoverableCount}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource ProjectSummaryCardStyle}" Margin="7,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Brush.Status.SuccessSubtle}"><ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource Brush.Status.Success}" FontSize="23"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="已完成" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding CompletedCount}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource ProjectSummaryCardStyle}" Margin="7,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Brush.Status.DangerSubtle}"><ui:SymbolIcon Symbol="Warning24" Foreground="{StaticResource Brush.Status.Danger}" FontSize="23"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="源文件缺失" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding MissingSourceCount}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Grid></Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="30,0,30,18"><Grid.ColumnDefinitions><ColumnDefinition Width="58*" MinWidth="470"/><ColumnDefinition Width="16"/><ColumnDefinition Width="42*" MinWidth="390"/></Grid.ColumnDefinitions>
            <Border x:Name="ProjectListCard" Style="{StaticResource CardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><Grid VerticalAlignment="Center" Margin="0,0,10,0"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProductTextBoxStyle}" Padding="34,0,10,0" ToolTip="搜索项目名称或视频路径"/><ui:SymbolIcon Symbol="Search24" Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/></Grid><ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Style="{StaticResource ProductComboBoxStyle}" VerticalAlignment="Center"/></Grid>
                <Grid Grid.Row="1" Margin="16,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="94"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><TextBlock Text="项目" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Grid.Column="1" Text="进度" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Grid.Column="2" Text="状态" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Grid.Column="3" Text="更新时间" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}"/></Grid>
                <ListView x:Name="ProjectList" Grid.Row="2" ItemsSource="{Binding ProjectsView}" SelectedItem="{Binding SelectedProject}" BorderThickness="0" ItemContainerStyle="{StaticResource ProjectListItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate><DataTemplate><Border x:Name="Row" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="94"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="46" Height="42" CornerRadius="7" Background="{StaticResource Brush.Status.InfoSubtle}"><Grid><ui:SymbolIcon Symbol="VideoClip24" Foreground="{StaticResource Brush.Brand.Default}" FontSize="25"/><Border Background="{StaticResource Brush.Surface.VideoOverlay}" VerticalAlignment="Bottom" CornerRadius="0,0,7,7" Padding="2"><TextBlock Text="{Binding DurationDisplay}" Foreground="White" FontSize="8" HorizontalAlignment="Center"/></Border></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MediaDetails}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,8,0"/></StackPanel></Grid>
                        <local:TaskProgressIndicator Grid.Column="1" Progress="{Binding ProgressPercent}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="6" Padding="7,4"><TextBlock Text="{Binding Status}" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.Brand.Default}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="已完成"><Setter Property="Foreground" Value="{StaticResource Brush.Status.SuccessText}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="失败，可恢复"><Setter Property="Foreground" Value="{StaticResource Brush.Status.DangerText}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource Brush.Surface.Info}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="已完成"><Setter Property="Background" Value="{StaticResource Brush.Status.SuccessSubtle}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="失败，可恢复"><Setter Property="Background" Value="{StaticResource Brush.Status.DangerSubtle}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="可继续"><Setter Property="Background" Value="{StaticResource Brush.Status.WarningSubtle}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                        <TextBlock Grid.Column="3" Text="{Binding UpdatedDisplay}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10" VerticalAlignment="Center"/>
                    </Grid><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource Brush.Surface.Default}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True"><Setter Property="Background" Value="{StaticResource Brush.Surface.Selected}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Default}"/><Setter Property="BorderThickness" Value="3,1,0,0"/><Setter Property="Padding" Value="13,12,16,12"/></DataTrigger></Style.Triggers></Style></Border.Style></Border></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2" Background="{StaticResource Brush.Surface.Default}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasVisibleProjects}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="310"><Border Width="58" Height="58" CornerRadius="14" Background="{StaticResource Brush.Surface.Info}"><ui:SymbolIcon Symbol="FolderOpen24" Foreground="{StaticResource Brush.Brand.Default}" FontSize="29"/></Border><TextBlock Text="{Binding EmptyStateTitle}" Style="{StaticResource Text.SectionTitle}" HorizontalAlignment="Center" Margin="0,16,0,0"/><TextBlock Text="{Binding EmptyStateDescription}" Foreground="{StaticResource Brush.Text.Secondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
            </Grid></Border>

            <Border x:Name="ProjectDetailCard" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="128"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
                <Grid Margin="20,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><StackPanel Margin="0,0,90,0"><TextBlock Text="{Binding SelectedProject.Name, TargetNullValue=选择一个项目查看详情}" Style="{StaticResource Text.SectionTitle}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SelectedProject.SourcePath}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource Brush.Status.SuccessSubtle}" CornerRadius="10" Padding="9,3"><TextBlock Text="{Binding SelectedProject.Status}" Foreground="{StaticResource Brush.Status.SuccessText}" FontSize="10"/></Border></Grid><local:TaskProgressIndicator Grid.Row="1" Progress="{Binding SelectedProject.ProgressPercent}" Margin="0,15,0,0"/><TextBlock Grid.Row="2" Text="{Binding SelectedProject.SizeDisplay}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,9,0,0"/></Grid>
                <TabControl Grid.Row="1" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0">
                    <TabItem Header="概览"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><TextBlock Text="源文件信息" FontWeight="SemiBold"/>
                        <UniformGrid Columns="2" Margin="-4,10,-4,0"><Border Style="{StaticResource ProjectFactCardStyle}"><StackPanel><TextBlock Text="分辨率" Style="{StaticResource Text.Meta}"/><TextBlock Text="{Binding SelectedProject.ResolutionDisplay}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border><Border Style="{StaticResource ProjectFactCardStyle}"><StackPanel><TextBlock Text="时长" Style="{StaticResource Text.Meta}"/><TextBlock Text="{Binding SelectedProject.DurationDisplay}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border><Border Style="{StaticResource ProjectFactCardStyle}"><StackPanel><TextBlock Text="项目占用" Style="{StaticResource Text.Meta}"/><TextBlock Text="{Binding SelectedProject.SizeDisplay}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border><Border Style="{StaticResource ProjectFactCardStyle}"><StackPanel><TextBlock Text="源文件状态" Style="{StaticResource Text.Meta}"/><TextBlock Text="{Binding SelectedProject.SourceStateDisplay}" Foreground="{StaticResource Brush.Status.SuccessText}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border></UniformGrid>
                        <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,16,0,0"><StackPanel><TextBlock Text="处理流程" FontWeight="SemiBold"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,14,0,0"><ItemsControl ItemsSource="{Binding SelectedProject.Stages}" MinWidth="650"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel HorizontalAlignment="Center" MinWidth="82"><Grid Height="22"><Border Height="2" Background="{StaticResource Brush.Border.Strong}" VerticalAlignment="Center"/><Ellipse Width="17" Height="17" Fill="{StaticResource Brush.Status.Success}"/><ui:SymbolIcon Symbol="Checkmark12" Foreground="White" FontSize="10"/></Grid><TextBlock Text="{Binding Name}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="{Binding UpdatedDisplay}" Style="{StaticResource Text.Meta}" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border>
                    </StackPanel></ScrollViewer></TabItem>
                    <TabItem Header="处理记录"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SelectedProject.Stages}" Margin="18"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><Ellipse Width="9" Height="9" Fill="{StaticResource Brush.Status.Success}" VerticalAlignment="Top" Margin="0,5,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding UpdatedDisplay}" Style="{StaticResource Text.Meta}" Margin="0,3,0,0"/><TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Status.DangerText}" TextWrapping="Wrap" FontSize="10" Margin="0,3,8,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
                    <TabItem Header="交付文件"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SelectedProject.Artifacts}" Margin="18"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="58"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FullPath}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis" Margin="0,4,8,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Kind}" HorizontalAlignment="Right"/><TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Right"/></StackPanel><Button Grid.Column="2" Content="打开" Tag="{Binding FullPath}" Click="OpenArtifact_OnClick" Style="{StaticResource CompactButtonStyle}" Margin="8,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
                </TabControl>
                <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="18,0"><Grid IsEnabled="{Binding HasSelection}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding SelectedProject.LibraryPrimaryActionText}" Click="PrimaryAction_OnClick" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="重新发布" Click="Republish_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button Content="打开目录" Click="OpenFolder_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="More_OnClick" Style="{StaticResource IconButtonStyle}"><ui:SymbolIcon Symbol="MoreHorizontal24"/><Button.ContextMenu><ContextMenu><MenuItem Header="清理缓存" Click="DeleteCache_OnClick"/><Separator/><MenuItem Header="删除项目" Foreground="{StaticResource Brush.Status.DangerText}" Click="DeleteProject_OnClick"/></ContextMenu></Button.ContextMenu></Button></Grid></Border>
            </Grid></Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource PageFooterStyle}" Padding="30,0"><Grid><TextBlock Text="{Binding ProjectSummaryDisplay, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding Message, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}"/></Grid></Border>
    </Grid>
</UserControl>
