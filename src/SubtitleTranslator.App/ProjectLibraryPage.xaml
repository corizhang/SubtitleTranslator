<UserControl x:Class="SubtitleTranslator.App.ProjectLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource Brush.Surface.App}" Loaded="Page_OnLoaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="{StaticResource Size.Header.Feature}"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource PageHeaderStyle}">
            <Grid Margin="30,0">
                <StackPanel VerticalAlignment="Center"><TextBlock Text="项目库" Style="{StaticResource Text.PageTitle}"/><TextBlock Text="查找历史任务、恢复处理并管理字幕交付文件" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,3,0,0"/></StackPanel>
                <Button Click="Refresh_OnClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowClockwise24" Margin="0,0,7,0"/><TextBlock Text="刷新项目"/></StackPanel></Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="30,20,30,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <UniformGrid Columns="4">
                <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,12,0"><Grid><StackPanel><TextBlock Text="全部项目" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding TotalCount}" FontSize="{StaticResource Font.Size.Kpi}" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><ui:SymbolIcon Symbol="Folder24" Foreground="{StaticResource Brush.Icon.Neutral}" FontSize="{StaticResource Font.Size.Kpi}" HorizontalAlignment="Right"/></Grid></Border>
                <Border Style="{StaticResource SummaryCardStyle}" Margin="4,0,8,0"><Grid><StackPanel><TextBlock Text="可继续或恢复" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding RecoverableCount}" FontSize="{StaticResource Font.Size.Kpi}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.WarningText}" Margin="0,5,0,0"/></StackPanel><ui:SymbolIcon Symbol="ArrowSync24" Foreground="{StaticResource Brush.Status.WarningIcon}" FontSize="{StaticResource Font.Size.Kpi}" HorizontalAlignment="Right"/></Grid></Border>
                <Border Style="{StaticResource SummaryCardStyle}" Margin="8,0,4,0"><Grid><StackPanel><TextBlock Text="已完成" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding CompletedCount}" FontSize="{StaticResource Font.Size.Kpi}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.SuccessTextStrong}" Margin="0,5,0,0"/></StackPanel><ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource Brush.Status.SuccessIcon}" FontSize="{StaticResource Font.Size.Kpi}" HorizontalAlignment="Right"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0" Padding="18,14"><Grid><StackPanel><TextBlock Text="源文件缺失" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding MissingSourceCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.Danger}" Margin="0,5,0,0"/></StackPanel><ui:SymbolIcon Symbol="Warning24" Foreground="{StaticResource Brush.Status.Danger}" FontSize="26" HorizontalAlignment="Right"/></Grid></Border>
            </UniformGrid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProductTextBoxStyle}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="按项目名或视频路径搜索"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Style="{StaticResource ProductComboBoxStyle}" VerticalAlignment="Center"/>
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{Binding ProjectsView}" SelectedItem="{Binding SelectedProject}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate><DataTemplate><Grid Margin="7,9"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Surface.Info}" VerticalAlignment="Top"><ui:SymbolIcon Symbol="VideoClip24" Foreground="{StaticResource Brush.Brand.Default}" FontSize="18"/></Border>
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourcePath}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,12,0"/><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,8,18,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.Brand.Default}" FontSize="{StaticResource Font.Size.Meta}"/></Border><TextBlock Text="{Binding UpdatedDisplay}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="{StaticResource Font.Size.Caption}" HorizontalAlignment="Right" Margin="0,7,0,0"/></StackPanel>
                            </Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <Border Grid.Row="1" Background="{StaticResource Brush.Surface.Default}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasVisibleProjects}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330"><Border Width="58" Height="58" CornerRadius="14" Background="{StaticResource Brush.Surface.Info}"><ui:SymbolIcon Symbol="FolderOpen24" Foreground="{StaticResource Brush.Brand.Default}" FontSize="29"/></Border><TextBlock Text="{Binding EmptyStateTitle}" Style="{StaticResource Text.SectionTitle}" HorizontalAlignment="Center" Margin="0,16,0,0"/><TextBlock Text="{Binding EmptyStateDescription}" Foreground="{StaticResource Brush.Text.Secondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="{Binding SelectedProject.Name, TargetNullValue=选择一个项目查看详情}" Style="{StaticResource Text.SectionTitle}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedProject.SourcePath}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                        <Grid Grid.Row="1" Margin="0,18,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedProject.Status}" Foreground="{StaticResource Brush.Brand.Default}" FontWeight="SemiBold"/><ProgressBar Value="{Binding SelectedProject.ProgressPercent, Mode=OneWay}" Maximum="100" Height="7" Margin="0,8,16,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SelectedProject.SizeDisplay}" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center"/></Grid>
                        <TabControl Grid.Row="2">
                            <TabItem Header="概览"><StackPanel Margin="12"><TextBlock Text="原视频" Style="{StaticResource Text.FieldLabel}"/><TextBlock Text="{Binding SelectedProject.SourceStateDisplay}" Foreground="{StaticResource Brush.Brand.Default}"/><TextBlock Text="项目占用" Style="{StaticResource Text.FieldLabel}" Margin="0,16,0,5"/><TextBlock Text="{Binding SelectedProject.SizeDisplay}"/><TextBlock Text="最近更新" Style="{StaticResource Text.FieldLabel}" Margin="0,16,0,5"/><TextBlock Text="{Binding SelectedProject.UpdatedDisplay}"/></StackPanel></TabItem>
                            <TabItem Header="处理记录"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SelectedProject.Stages}" Margin="12"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Brand.Default}" VerticalAlignment="Top" Margin="0,5,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Status.Danger}" FontSize="11" TextWrapping="Wrap" Margin="0,3,8,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
                            <TabItem Header="交付文件"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SelectedProject.Artifacts}" Margin="12"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FullPath}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Kind}" HorizontalAlignment="Right"/><TextBlock Text="{Binding SizeDisplay}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10" HorizontalAlignment="Right"/></StackPanel><Button Grid.Column="2" Content="打开" Tag="{Binding FullPath}" Click="OpenArtifact_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" MinHeight="28" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
                        </TabControl>
                        <Grid Grid.Row="3" Margin="0,16,0,0" IsEnabled="{Binding HasSelection}"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="继续任务" Click="Resume_OnClick" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="校订字幕" Click="OpenSubtitle_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button Content="重新发布" Click="Republish_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0"><Button Content="打开目录" Click="OpenFolder_OnClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="清理缓存" Click="DeleteCache_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button Content="删除项目" Click="DeleteProject_OnClick" Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource Brush.Status.Danger}" Margin="8,0,0,0"/></StackPanel></Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource PageFooterStyle}" Padding="30,12"><TextBlock Text="{Binding Message}" Foreground="{StaticResource Brush.Text.Secondary}"/></Border>
    </Grid>
</UserControl>
