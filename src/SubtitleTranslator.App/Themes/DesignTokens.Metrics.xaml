<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- 4 px spacing scale. -->
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.5">20</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>
    <sys:Double x:Key="Space.8">32</sys:Double>
    <sys:Double x:Key="Space.10">40</sys:Double>

    <Thickness x:Key="Inset.Control.Default">16,8</Thickness>
    <Thickness x:Key="Inset.Control.Compact">8,4</Thickness>
    <Thickness x:Key="Inset.Card.Default">20</Thickness>
    <Thickness x:Key="Inset.Page.Default">30,24,30,26</Thickness>
    <Thickness x:Key="Gap.Section.Default">0,16,0,0</Thickness>

    <CornerRadius x:Key="Radius.Badge">999</CornerRadius>
    <CornerRadius x:Key="Radius.Control">7</CornerRadius>
    <CornerRadius x:Key="Radius.Card">11</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">9</CornerRadius>

    <sys:Double x:Key="Size.Control.Compact">32</sys:Double>
    <sys:Double x:Key="Size.Control.Default">38</sys:Double>
    <sys:Double x:Key="Size.IconButton.Default">38</sys:Double>
    <!-- Grid definitions require GridLength resources; Double cannot be assigned at runtime. -->
    <GridLength x:Key="Size.Header.Page">76</GridLength>
    <GridLength x:Key="Size.Header.Feature">86</GridLength>
    <GridLength x:Key="Size.Footer.Action">64</GridLength>
    <GridLength x:Key="Size.Sidebar.Width">220</GridLength>
    <GridLength x:Key="Size.Editor.ListPane">370</GridLength>
    <GridLength x:Key="Size.Editor.InspectorPane">330</GridLength>
    <GridLength x:Key="Size.Inspector.Default">320</GridLength>
    <sys:Double x:Key="Size.Editor.VideoMaxHeight">640</sys:Double>
    <GridLength x:Key="Size.Player.Controls">88</GridLength>
    <GridLength x:Key="Size.Player.Timeline">112</GridLength>

</ResourceDictionary>
