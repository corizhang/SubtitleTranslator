<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Primitive palette: do not consume directly from pages. -->
    <Color x:Key="Palette.Brand.500">#4F6BFF</Color>
    <Color x:Key="Palette.Brand.600">#4058D9</Color>
    <Color x:Key="Palette.Neutral.0">#FFFFFF</Color>
    <Color x:Key="Palette.Neutral.25">#FCFCFD</Color>
    <Color x:Key="Palette.Neutral.50">#F8F9FC</Color>
    <Color x:Key="Palette.Neutral.100">#F2F4F7</Color>
    <Color x:Key="Palette.Neutral.200">#E4E7EC</Color>
    <Color x:Key="Palette.Neutral.300">#D0D5DD</Color>
    <Color x:Key="Palette.Neutral.400">#98A2B3</Color>
    <Color x:Key="Palette.Neutral.500">#667085</Color>
    <Color x:Key="Palette.Neutral.600">#475467</Color>
    <Color x:Key="Palette.Neutral.700">#344054</Color>
    <Color x:Key="Palette.Neutral.900">#182033</Color>
    <Color x:Key="Palette.Success.50">#ECFDF3</Color>
    <Color x:Key="Palette.Success.600">#16A36A</Color>
    <Color x:Key="Palette.Warning.50">#FFF8E8</Color>
    <Color x:Key="Palette.Warning.200">#F6D58D</Color>
    <Color x:Key="Palette.Warning.600">#B54708</Color>
    <Color x:Key="Palette.Danger.50">#FEE4E2</Color>
    <Color x:Key="Palette.Danger.600">#D64545</Color>

    <!-- Semantic brushes: pages and components consume these keys. -->
    <SolidColorBrush x:Key="Brush.Surface.App" Color="#F6F7FB"/>
    <SolidColorBrush x:Key="Brush.Surface.Default" Color="{StaticResource Palette.Neutral.0}"/>
    <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="{StaticResource Palette.Neutral.50}"/>
    <SolidColorBrush x:Key="Brush.Surface.Muted" Color="{StaticResource Palette.Neutral.100}"/>
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="#F5F7FF"/>
    <SolidColorBrush x:Key="Brush.Surface.Info" Color="#EEF3FF"/>
    <SolidColorBrush x:Key="Brush.Surface.Danger" Color="#FFF4ED"/>
    <SolidColorBrush x:Key="Brush.Surface.Video" Color="#0B101A"/>
    <SolidColorBrush x:Key="Brush.Surface.Sidebar" Color="#151D31"/>
    <SolidColorBrush x:Key="Brush.Surface.SidebarHover" Color="#22304E"/>
    <SolidColorBrush x:Key="Brush.Surface.SidebarSelected" Color="#29437F"/>
    <SolidColorBrush x:Key="Brush.Surface.SidebarFocus" Color="#223A70"/>
    <SolidColorBrush x:Key="Brush.Surface.SidebarPanel" Color="#1E2942"/>
    <SolidColorBrush x:Key="Brush.Brand.Default" Color="{StaticResource Palette.Brand.500}"/>
    <SolidColorBrush x:Key="Brush.Brand.Hover" Color="{StaticResource Palette.Brand.600}"/>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Palette.Neutral.900}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Palette.Neutral.500}"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Palette.Neutral.400}"/>
    <SolidColorBrush x:Key="Brush.Text.OnBrand" Color="{StaticResource Palette.Neutral.0}"/>
    <SolidColorBrush x:Key="Brush.Text.OnDark" Color="{StaticResource Palette.Neutral.0}"/>
    <SolidColorBrush x:Key="Brush.Text.Sidebar" Color="#D7DDEC"/>
    <SolidColorBrush x:Key="Brush.Text.SidebarMuted" Color="#8F9BB3"/>
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Palette.Neutral.200}"/>
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Palette.Neutral.300}"/>
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="#A9B8FF"/>
    <SolidColorBrush x:Key="Brush.Border.BrandHover" Color="#9AACFF"/>
    <SolidColorBrush x:Key="Brush.Border.Info" Color="#B9C7FF"/>
    <SolidColorBrush x:Key="Brush.Border.Success" Color="#B7E7D1"/>
    <SolidColorBrush x:Key="Brush.Border.Warning" Color="{StaticResource Palette.Warning.200}"/>
    <SolidColorBrush x:Key="Brush.Track.Default" Color="#DCE3F0"/>
    <SolidColorBrush x:Key="Brush.Brand.PressedSubtle" Color="#E9EEFF"/>
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Palette.Success.600}"/>
    <SolidColorBrush x:Key="Brush.Status.SuccessTextStrong" Color="#176B47"/>
    <SolidColorBrush x:Key="Brush.Status.SuccessIcon" Color="#2A9D68"/>
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="Brush.Status.WarningIcon" Color="#E48A31"/>
    <SolidColorBrush x:Key="Brush.Status.Danger" Color="{StaticResource Palette.Danger.600}"/>
    <SolidColorBrush x:Key="Brush.Status.SuccessSubtle" Color="{StaticResource Palette.Success.50}"/>
    <SolidColorBrush x:Key="Brush.Status.WarningSubtle" Color="{StaticResource Palette.Warning.50}"/>
    <SolidColorBrush x:Key="Brush.Status.DangerSubtle" Color="{StaticResource Palette.Danger.50}"/>
    <SolidColorBrush x:Key="Brush.Status.InfoSubtle" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="Brush.Status.SuccessText" Color="#087A4B"/>
    <SolidColorBrush x:Key="Brush.Status.WarningText" Color="{StaticResource Palette.Warning.600}"/>
    <SolidColorBrush x:Key="Brush.Status.DangerText" Color="#D92D20"/>
    <SolidColorBrush x:Key="Brush.Icon.Neutral" Color="#8091B2"/>

</ResourceDictionary>
