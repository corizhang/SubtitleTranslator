<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <FontFamily x:Key="Font.Family.UI">Segoe UI, Microsoft YaHei UI</FontFamily>
    <sys:Double x:Key="Font.Size.Caption">10</sys:Double>
    <sys:Double x:Key="Font.Size.Meta">11</sys:Double>
    <sys:Double x:Key="Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="Font.Size.BodyStrong">14</sys:Double>
    <sys:Double x:Key="Font.Size.SectionTitle">17</sys:Double>
    <sys:Double x:Key="Font.Size.EditorTitle">23</sys:Double>
    <sys:Double x:Key="Font.Size.PageTitle">27</sys:Double>
    <sys:Double x:Key="Font.Size.Kpi">26</sys:Double>

    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.PageTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
    </Style>
    <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.SectionTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
    </Style>
    <Style x:Key="Text.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Text.Meta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Meta}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.PageTitle}"/>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.SectionTitle}"/>
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.FieldLabel}"/>
</ResourceDictionary>
