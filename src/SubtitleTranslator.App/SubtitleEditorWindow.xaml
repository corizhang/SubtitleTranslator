<ui:FluentWindow x:Class="SubtitleTranslator.App.SubtitleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="字幕预览与校订中心" Width="1240" Height="800" MinWidth="1040" MinHeight="680"
        Background="{StaticResource Brush.Surface.App}" WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Loaded="Window_OnLoaded" Closing="Window_OnClosing">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="78"/><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
        <ui:TitleBar Title="字幕预览与校订中心" ShowMinimize="True" ShowMaximize="True"/>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <StackPanel VerticalAlignment="Center"><TextBlock Text="字幕校订" Style="{StaticResource Text.PageTitle}"/><TextBlock x:Name="FilePathText" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,3,260,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Click="OpenVideo_OnClick" Style="{StaticResource SecondaryButtonStyle}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play24" Margin="0,0,7,0"/><TextBlock Text="外部播放视频"/></StackPanel></Button><Button Click="Validate_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ShieldCheckmark24" Margin="0,0,7,0"/><TextBlock Text="重新检查"/></StackPanel></Button></StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="4" Margin="30,14,30,0">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="16,11"><Grid><StackPanel><TextBlock Text="字幕条目" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding TotalCueCount}" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><ui:SymbolIcon Symbol="TextBulletList24" Foreground="{StaticResource Brush.Icon.Neutral}" FontSize="24" HorizontalAlignment="Right"/></Grid></Border>
            <Border Style="{StaticResource CardStyle}" Margin="4,0,8,0" Padding="16,11"><Grid><StackPanel><TextBlock Text="错误" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding ErrorCount}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.Danger}" Margin="0,3,0,0"/></StackPanel><ui:SymbolIcon Symbol="DismissCircle24" Foreground="{StaticResource Brush.Status.Danger}" FontSize="24" HorizontalAlignment="Right"/></Grid></Border>
            <Border Style="{StaticResource CardStyle}" Margin="8,0,4,0" Padding="16,11"><Grid><StackPanel><TextBlock Text="提示" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding WarningCount}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.WarningText}" Margin="0,3,0,0"/></StackPanel><ui:SymbolIcon Symbol="Warning24" Foreground="{StaticResource Brush.Status.WarningIcon}" FontSize="24" HorizontalAlignment="Right"/></Grid></Border>
            <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0" Padding="16,11"><Grid><StackPanel><TextBlock Text="修改状态" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding DirtyStateDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Brand.Default}" Margin="0,8,36,0"/></StackPanel><ui:SymbolIcon Symbol="Edit24" Foreground="{StaticResource Brush.Brand.Default}" FontSize="24" HorizontalAlignment="Right"/></Grid></Border>
        </UniformGrid>

        <Grid Grid.Row="3" Margin="30,16,30,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="字幕列表" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding IssueFilters}" SelectedItem="{Binding IssueFilter}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0"><Button Content="上一问题" Click="PreviousIssue_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="11,5" MinHeight="32"/><Button Content="下一问题" Click="NextIssue_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="11,5" MinHeight="32" Margin="6,0,0,0"/></StackPanel></Grid>
                    <DataGrid x:Name="CueGrid" Grid.Row="1" ItemsSource="{Binding CuesView}" SelectedItem="{Binding SelectedCue}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="48">
                        <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Number}" Width="46"/><DataGridTextColumn Header="时间" Binding="{Binding StartText}" Width="105"/><DataGridTextColumn Header="字幕内容" Binding="{Binding Preview}" Width="*"/><DataGridTextColumn Header="检查" Binding="{Binding IssueSummary}" Width="155"/></DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                <Grid IsEnabled="{Binding HasSelection}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock Text="编辑当前字幕" Style="{StaticResource Text.SectionTitle}"/><TextBlock Text="{Binding SelectedCue.Number, StringFormat=第 {0} 条}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0"/></StackPanel><Border Background="{StaticResource Brush.Surface.Info}" CornerRadius="11" Padding="9,4" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="{Binding SelectedCue.IssueStateDisplay, TargetNullValue=等待选择}" Foreground="{StaticResource Brush.Brand.Default}" FontSize="10" MaxWidth="190" TextTrimming="CharacterEllipsis"/></Border></Grid>
                    <Grid Grid.Row="1" Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开始时间" Style="{StaticResource Text.FieldLabel}"/><TextBox Text="{Binding SelectedCue.StartText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="结束时间" Style="{StaticResource Text.FieldLabel}"/><TextBox Text="{Binding SelectedCue.EndText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                    <TextBlock Grid.Row="2" Text="字幕正文（双语字幕可保留多行）" Style="{StaticResource Text.FieldLabel}"/>
                    <TextBox Grid.Row="3" Text="{Binding SelectedCue.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MinHeight="170"/>
                    <Border Grid.Row="4" Background="{StaticResource Brush.Surface.Danger}" CornerRadius="7" Padding="11" Margin="0,14,0,0"><StackPanel><TextBlock Text="当前检查结果" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.WarningText}"/><TextBlock Text="{Binding SelectedCue.IssueStateDisplay, TargetNullValue=未发现问题}" Foreground="{StaticResource Brush.Status.DangerText}" TextWrapping="Wrap" MinHeight="18" Margin="0,4,0,0"/></StackPanel></Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="30,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap"/><TextBlock Text="错误会阻止保存；提示不会阻止保存，可根据语境选择处理。" Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="另存为" Click="SaveAs_OnClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="保存并发布" Click="SaveAndPublish_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button Content="保存" Click="Save_OnClick" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/><Button Content="关闭" Click="Close_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
