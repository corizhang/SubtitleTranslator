<Window x:Class="SubtitleTranslator.App.SubtitleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字幕预览与校订中心" Width="1180" Height="760" MinWidth="960" MinHeight="620"
        Background="#F4F6FA" WindowStartupLocation="CenterOwner" Loaded="Window_OnLoaded" Closing="Window_OnClosing">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="字幕预览与校订中心" FontSize="27" FontWeight="SemiBold" Foreground="#172033"/>
                <TextBlock x:Name="FilePathText" Foreground="#667085" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="打开视频" Click="OpenVideo_OnClick"/>
                <Button Content="重新检查" Click="Validate_OnClick"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="9" Padding="10">
                <DataGrid x:Name="CueGrid" ItemsSource="{Binding Cues}" SelectedItem="{Binding SelectedCue}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="0" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="48"/>
                        <DataGridTextColumn Header="开始" Binding="{Binding StartText}" Width="112"/>
                        <DataGridTextColumn Header="结束" Binding="{Binding EndText}" Width="112"/>
                        <DataGridTextColumn Header="字幕内容" Binding="{Binding Preview}" Width="*"/>
                        <DataGridTextColumn Header="检查" Binding="{Binding IssueSummary}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="9" Padding="20">
                <Grid IsEnabled="{Binding HasSelection}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="编辑当前字幕" FontSize="19" FontWeight="SemiBold" Foreground="#27324A"/>
                    <Grid Grid.Row="1" Margin="0,18,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="开始时间" Foreground="#475467" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedCue.StartText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="结束时间" Foreground="#475467" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedCue.EndText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="字幕正文（双语字幕可保留多行）" Foreground="#475467" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="3" Text="{Binding SelectedCue.Text, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    <Border Grid.Row="4" Background="#FFF4ED" CornerRadius="5" Padding="10" Margin="0,14,0,0">
                        <TextBlock Text="{Binding SelectedCue.IssueSummary}" Foreground="#B42318" TextWrapping="Wrap" MinHeight="18"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="#667085" TextWrapping="Wrap"/>
                <TextBlock Text="时间格式：00:00:00,000。红色错误会阻止覆盖保存，黄色提示可按需处理。" Foreground="#98A2B3" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="上一问题" Click="PreviousIssue_OnClick"/>
                <Button Content="下一问题" Click="NextIssue_OnClick"/>
                <Button Content="另存为" Click="SaveAs_OnClick"/>
                <Button Content="保存并发布" Click="SaveAndPublish_OnClick"/>
                <Button Content="保存" Click="Save_OnClick" Background="#315EFB" Foreground="White" BorderThickness="0"/>
                <Button Content="关闭" Click="Close_OnClick"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
