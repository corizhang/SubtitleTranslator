<UserControl x:Class="SubtitleTranslator.App.ResourceManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource AppBackgroundBrush}" Loaded="Page_OnLoaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="30,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="资源与模型" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="维护本地识别组件、模型和翻译服务，不影响已经完成的项目" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="首次配置向导" Click="OpenWizard_OnClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Command="{Binding RefreshEnvironmentCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowClockwise24" Margin="0,0,7,0"/><TextBlock Text="重新检测"/></StackPanel></Button></StackPanel></Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,20,30,24">
                <Border Style="{StaticResource CardStyle}" Background="#F7F9FF" BorderBrush="#B9C7FF">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="12" Background="#E7ECFF"><ui:SymbolIcon Symbol="Pulse24" Foreground="{StaticResource PrimaryBrush}" FontSize="24"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding ResourceReadinessDisplay}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="识别所需的 5 项本地资源与 DeepSeek 翻译服务统一检测" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding ReadyResourceCount, StringFormat=已就绪 {0}/6}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/><ProgressBar Value="{Binding ReadyResourceCount, Mode=OneWay}" Maximum="6" Width="170" Height="7" Margin="0,8,0,0"/></StackPanel></Grid>
                </Border>

                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}"><StackPanel><Grid><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="9" Background="#EEF3FF"><ui:SymbolIcon Symbol="Video24" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="GPU 与推理设备" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="可选加速能力" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></StackPanel></StackPanel><Border Background="#F2F4F7" CornerRadius="11" Padding="9,4" HorizontalAlignment="Right"><TextBlock Text="硬件检测" Foreground="{StaticResource PrimaryBrush}"/></Border></Grid><TextBlock Text="{Binding HardwareStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/><Button Content="重新检测硬件" Command="{Binding RefreshEnvironmentCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><Grid><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="9" Background="#EEF3FF"><ui:SymbolIcon Symbol="Box24" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Whisper Runtime" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="本地语音识别引擎" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></StackPanel></StackPanel><Border Background="#F2F4F7" CornerRadius="11" Padding="9,4" HorizontalAlignment="Right"><TextBlock Text="{Binding RuntimeStatus}" Foreground="{StaticResource PrimaryBrush}"/></Border></Grid><TextBlock Text="{Binding RuntimePathDisplay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/><WrapPanel Margin="0,16,0,0"><Button Content="选择目录" Click="SelectRuntime_OnClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="安装 CUDA" Command="{Binding InstallCudaRuntimeCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/><Button Content="安装 CPU" Command="{Binding InstallCpuRuntimeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></WrapPanel><ProgressBar Value="{Binding ComponentInstallProgress, Mode=OneWay}" Height="6" Margin="0,14,0,0"/><TextBlock Text="{Binding ComponentInstallStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><Grid><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="9" Background="#EEF3FF"><ui:SymbolIcon Symbol="SoundWaveCircle24" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Silero VAD" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="语音片段定位模型" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></StackPanel></StackPanel><Border Background="#F2F4F7" CornerRadius="11" Padding="9,4" HorizontalAlignment="Right"><TextBlock Text="{Binding VadStatus}" Foreground="{StaticResource PrimaryBrush}"/></Border></Grid><TextBlock Text="{Binding VadPathDisplay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="选择本地模型" Click="SelectVad_OnClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="下载推荐 VAD" Command="{Binding InstallVadCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardStyle}"><StackPanel><Grid><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="9" Background="#EEF3FF"><ui:SymbolIcon Symbol="Filmstrip24" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="FFmpeg" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="媒体读取与音频提取" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></StackPanel></StackPanel><Border Background="#F2F4F7" CornerRadius="11" Padding="9,4" HorizontalAlignment="Right"><TextBlock Text="{Binding FfmpegStatus}" Foreground="{StaticResource PrimaryBrush}"/></Border></Grid><TextBlock Text="{Binding FfmpegPathDisplay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="选择 ffmpeg.exe" Click="SelectFfmpeg_OnClick" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="打开下载页面" Command="{Binding OpenFfmpegDownloadCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><Grid><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="9" Background="#EEF3FF"><ui:SymbolIcon Symbol="BrainCircuit24" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Whisper 模型" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="语音识别精度与速度" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></StackPanel></StackPanel><Border Background="#F2F4F7" CornerRadius="11" Padding="9,4" HorizontalAlignment="Right"><TextBlock Text="{Binding WhisperModelStatus}" Foreground="{StaticResource PrimaryBrush}"/></Border></Grid><ComboBox ItemsSource="{Binding SpeechModels}" SelectedItem="{Binding SelectedSpeechModel}" Margin="0,14,0,0"/><TextBlock Text="{Binding WhisperModelPathDisplay}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="选择本地模型" Click="SelectModel_OnClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="下载所选模型" Command="{Binding DownloadModelCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/><Button Content="取消" Command="{Binding CancelModelDownloadCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel><ProgressBar Value="{Binding ModelDownloadProgress, Mode=OneWay}" Height="6" Margin="0,14,0,0"/><TextBlock Text="{Binding ModelStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><Grid><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="9" Background="#EEF3FF"><ui:SymbolIcon Symbol="Translate24" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="DeepSeek" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="中文字幕翻译服务" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></StackPanel></StackPanel><Border Background="#F2F4F7" CornerRadius="11" Padding="9,4" HorizontalAlignment="Right"><TextBlock Text="{Binding ApiKeyStatus}" Foreground="{StaticResource PrimaryBrush}" MaxWidth="190" TextTrimming="CharacterEllipsis"/></Border></Grid><PasswordBox x:Name="DeepSeekApiKeyBox" Margin="0,14,0,0"/><WrapPanel Margin="0,16,0,0"><Button Content="加密保存" Click="SaveApiKey_OnClick" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="测试连接" Command="{Binding TestDeepSeekConnectionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button Content="删除密钥" Command="{Binding DeleteApiKeyCommand}" Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource DangerBrush}" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="{Binding DeepSeekConnectionStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="30,12"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="本地推理自检" FontWeight="SemiBold"/><TextBlock Text="{Binding SelfTestStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,300,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="移除应用管理的组件" Click="RemoveManaged_OnClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="运行推理自检" Command="{Binding RunSelfTestCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid></Border>
    </Grid>
</UserControl>
