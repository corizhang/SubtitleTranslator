<UserControl x:Class="SubtitleTranslator.App.SubtitleEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="{StaticResource Brush.Surface.App}" Loaded="Page_OnLoaded" Unloaded="Page_OnUnloaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="{StaticResource Size.Footer.Action}"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Brush.Surface.Default}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Click="Back_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="11,7" Margin="0,0,14,0"><ui:SymbolIcon Symbol="ArrowLeft24"/></Button><StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="ProjectTitleText" FontSize="{StaticResource Font.Size.EditorTitle}" FontWeight="SemiBold"/><Border Background="{StaticResource Brush.Status.SuccessSubtle}" CornerRadius="{StaticResource Radius.Badge}" Padding="9,3" Margin="12,2,0,0"><TextBlock Text="已生成" Foreground="{StaticResource Brush.Status.SuccessText}" FontSize="{StaticResource Font.Size.Meta}"/></Border></StackPanel><TextBlock x:Name="SubtitlePathText" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="{StaticResource Font.Size.Caption}" TextTrimming="CharacterEllipsis" MaxWidth="620" Margin="0,4,0,0"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="打开视频位置" Click="OpenExternal_OnClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="保存并发布" Click="SavePublish_OnClick" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource Size.Editor.ListPane}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="{StaticResource Size.Editor.InspectorPane}"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Brush.Surface.Default}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,1,0">
                <Grid Margin="18,16,14,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProductTextBoxStyle}" Padding="34,0,10,0" ToolTip="搜索字幕正文或编号"/>
                        <ui:SymbolIcon Symbol="Search24" Foreground="{StaticResource Brush.Text.Secondary}" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <TextBlock Text="搜索字幕（Ctrl+F）" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,4,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <ToggleButton x:Name="AllFilterButton" Tag="全部字幕" Click="Filter_OnClick" Style="{StaticResource FilterToggleButtonStyle}" Margin="3,0"><StackPanel Orientation="Horizontal"><TextBlock Text="全部"/><Border Style="{StaticResource BadgeStyle}" Background="{StaticResource Brush.Status.InfoSubtle}" Margin="5,0,0,0"><TextBlock Text="{Binding TotalCueCount}" FontSize="{StaticResource Font.Size.Caption}" Foreground="{StaticResource Brush.Brand.Default}"/></Border></StackPanel></ToggleButton>
                        <ToggleButton x:Name="ErrorFilterButton" Grid.Column="1" Tag="仅错误" Click="Filter_OnClick" Style="{StaticResource FilterToggleButtonStyle}" Margin="3,0"><StackPanel Orientation="Horizontal"><TextBlock Text="错误"/><Border Style="{StaticResource BadgeStyle}" Background="{StaticResource Brush.Status.DangerSubtle}" Margin="5,0,0,0"><TextBlock Text="{Binding ErrorCount}" FontSize="{StaticResource Font.Size.Caption}" Foreground="{StaticResource Brush.Status.DangerText}"/></Border></StackPanel></ToggleButton>
                        <ToggleButton x:Name="SuggestionFilterButton" Grid.Column="2" Tag="仅提示" Click="Filter_OnClick" Style="{StaticResource FilterToggleButtonStyle}" Margin="3,0"><StackPanel Orientation="Horizontal"><TextBlock Text="建议"/><Border Style="{StaticResource BadgeStyle}" Background="{StaticResource Brush.Status.WarningSubtle}" Margin="5,0,0,0"><TextBlock Text="{Binding WarningCount}" FontSize="{StaticResource Font.Size.Caption}" Foreground="{StaticResource Brush.Status.WarningText}"/></Border></StackPanel></ToggleButton>
                        <ToggleButton x:Name="ModifiedFilterButton" Grid.Column="3" Tag="已修改" Click="Filter_OnClick" Style="{StaticResource FilterToggleButtonStyle}" Margin="3,0"><StackPanel Orientation="Horizontal"><TextBlock Text="已修改"/><Border Style="{StaticResource BadgeStyle}" Background="{StaticResource Brush.Status.SuccessSubtle}" Margin="5,0,0,0"><TextBlock Text="{Binding ModifiedCount}" FontSize="{StaticResource Font.Size.Caption}" Foreground="{StaticResource Brush.Status.SuccessText}"/></Border></StackPanel></ToggleButton>
                    </Grid>
                    <ListView x:Name="CueGrid" Grid.Row="2" Grid.RowSpan="2" ItemsSource="{Binding CuesView}" SelectedItem="{Binding SelectedCue}" SelectionChanged="CueGrid_OnSelectionChanged" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><ContentPresenter HorizontalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate><Border x:Name="CueCard" CornerRadius="7" Padding="12" Margin="0,0,4,8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Number, StringFormat=# {0}}" Foreground="{StaticResource Brush.Brand.Default}" FontWeight="SemiBold" FontSize="11"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0"><TextBlock Text="{Binding StartText}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11"/><TextBlock Text="  →  " Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="11"/><TextBlock Text="{Binding EndText}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="●" ToolTip="{Binding IssueStateDisplay}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/><Style.Triggers><DataTrigger Binding="{Binding HasIssue}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}"/></DataTrigger><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Status.DangerText}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBlock Text="{Binding OriginalText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0" MaxHeight="42" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding TranslationText}" Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="42" TextTrimming="CharacterEllipsis"/></StackPanel><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Default}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Background" Value="{StaticResource Brush.Surface.Selected}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid x:Name="CenterWorkspace" Grid.Column="1" Background="{StaticResource Brush.Surface.Subtle}" SizeChanged="CenterWorkspace_OnSizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="{StaticResource Size.Footer.Action}"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="VideoFrame" Margin="16,16,16,0" Background="{StaticResource Brush.Surface.Video}" CornerRadius="{StaticResource Radius.Panel}" ClipToBounds="True" MinHeight="260" MaxHeight="{StaticResource Size.Editor.VideoMaxHeight}">
                    <Grid>
                        <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaOpened="MediaOpened_OnHandler" MediaFailed="MediaFailed_OnHandler"/>
                        <vlc:VideoView x:Name="VlcVideoView" Visibility="Collapsed">
                            <Grid Background="Transparent"><StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="30"><TextBlock Text="{Binding SelectedCue.OriginalText}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"><TextBlock.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9"/></TextBlock.Effect></TextBlock><TextBlock Text="{Binding SelectedCue.TranslationText}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"><TextBlock.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9"/></TextBlock.Effect></TextBlock></StackPanel></Grid>
                        </vlc:VideoView>
                        <StackPanel x:Name="PlayerFallback" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"><ui:SymbolIcon Symbol="VideoClipOff24" Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="42"/><TextBlock x:Name="PlayerFallbackText" Text="正在打开视频预览……" Foreground="{StaticResource Brush.Border.Strong}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/><Button Content="使用外部播放器" Click="OpenExternal_OnClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center" Margin="0,14,0,0"/></StackPanel>
                        <StackPanel x:Name="SystemSubtitleOverlay" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="30"><TextBlock Text="{Binding SelectedCue.OriginalText}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"><TextBlock.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9"/></TextBlock.Effect></TextBlock><TextBlock Text="{Binding SelectedCue.TranslationText}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"><TextBlock.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9"/></TextBlock.Effect></TextBlock></StackPanel>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Background="{StaticResource Brush.Surface.VideoOverlay}" CornerRadius="10" Padding="8,4"><TextBlock x:Name="PlaybackEngineText" Text="系统播放器" Foreground="White" FontSize="11"/></Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PlayButton" Content="播放" Click="Play_OnClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Grid.Column="1" Content="上一条" Click="PreviousIssue_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button Grid.Column="2" Content="下一条" Click="NextIssue_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Slider x:Name="PlaybackSlider" Grid.Column="3" Margin="16,0" IsHitTestVisible="False"/><StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="PlaybackTimeText" Text="00:00:00.000" Foreground="{StaticResource Brush.Brand.Default}"/><TextBlock Text=" / "/><TextBlock x:Name="PlaybackDurationText" Text="00:00:00" Foreground="{StaticResource Brush.Text.Secondary}"/></StackPanel></Grid>
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0"><Grid Margin="22,14" VerticalAlignment="Top"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="当前字幕时间轴" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedCue.StartText, StringFormat=开始 {0}}" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Brand.Default}"/><TextBlock Text="{Binding SelectedCue.EndText, StringFormat=结束 {0}}" HorizontalAlignment="Right" Foreground="{StaticResource Brush.Text.Secondary}"/></Grid><Border Grid.Row="1" Height="6" Background="{StaticResource Brush.Track.Default}" CornerRadius="3" Margin="0,18,0,0"><Border Width="10" Height="10" Background="{StaticResource Brush.Brand.Default}" CornerRadius="5" HorizontalAlignment="Center"/></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,34,0,0"><Button Content="‹  前 3 秒" Style="{StaticResource SecondaryButtonStyle}" Padding="18,8"/><Button Content="后 3 秒  ›" Style="{StaticResource SecondaryButtonStyle}" Padding="18,8" Margin="120,0,0,0"/></StackPanel></Grid></Border>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource Brush.Surface.Default}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,18,18,22"><Grid><StackPanel><TextBlock Text="{Binding SelectedCue.Number, StringFormat=当前字幕 #{0}}" Style="{StaticResource Text.SectionTitle}"/><TextBlock Text="{Binding DirtyStateDisplay}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Click="PreviousCue_OnClick" Style="{StaticResource IconButtonStyle}" ToolTip="上一条字幕"><ui:SymbolIcon Symbol="ChevronUp24"/></Button><Button Click="NextCue_OnClick" Style="{StaticResource IconButtonStyle}" Margin="6,0,0,0" ToolTip="下一条字幕"><ui:SymbolIcon Symbol="ChevronDown24"/></Button></StackPanel></Grid>
                    <TextBlock Text="开始时间" Style="{StaticResource Text.FieldLabel}" Margin="0,20,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="6"/><ColumnDefinition Width="52"/><ColumnDefinition Width="6"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBox Text="{Binding SelectedCue.StartText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProductTextBoxStyle}"/><Button Grid.Column="2" Content="-100" Tag="-100" ToolTip="开始时间提前 100 毫秒" Click="NudgeStart_OnClick" Style="{StaticResource CompactButtonStyle}" Padding="4"/><Button Grid.Column="4" Content="+100" Tag="100" ToolTip="开始时间延后 100 毫秒" Click="NudgeStart_OnClick" Style="{StaticResource CompactButtonStyle}" Padding="4"/></Grid>
                    <TextBlock Text="结束时间" Style="{StaticResource Text.FieldLabel}" Margin="0,14,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="6"/><ColumnDefinition Width="52"/><ColumnDefinition Width="6"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBox Text="{Binding SelectedCue.EndText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProductTextBoxStyle}"/><Button Grid.Column="2" Content="-100" Tag="-100" ToolTip="结束时间提前 100 毫秒" Click="NudgeEnd_OnClick" Style="{StaticResource CompactButtonStyle}" Padding="4"/><Button Grid.Column="4" Content="+100" Tag="100" ToolTip="结束时间延后 100 毫秒" Click="NudgeEnd_OnClick" Style="{StaticResource CompactButtonStyle}" Padding="4"/></Grid>
                    <TextBlock Text="原文" Style="{StaticResource Text.FieldLabel}" Margin="0,18,0,6"/><TextBox Text="{Binding SelectedCue.OriginalText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82" VerticalContentAlignment="Top"/>
                    <TextBlock Text="译文（简体中文）" Style="{StaticResource Text.FieldLabel}" Margin="0,16,0,6"/><TextBox Text="{Binding SelectedCue.TranslationText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" VerticalContentAlignment="Top"/>
                    <Border Background="{StaticResource Brush.Status.WarningSubtle}" BorderBrush="{StaticResource Brush.Border.Warning}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="12" Margin="0,16,0,0"><StackPanel><TextBlock Text="检查结果" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.WarningText}"/><TextBlock Text="{Binding SelectedCue.IssueStateDisplay}" Foreground="{StaticResource Brush.Status.WarningText}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>

        <Border x:Name="EditorFooter" Grid.Row="2" Background="{StaticResource Brush.Surface.Default}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0"><Grid Margin="24,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Status.Success}"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="8,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="重新检查" Click="Validate_OnClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="保存" Click="Save_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button Content="保存并发布" Click="SavePublish_OnClick" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid></Border>
    </Grid>
</UserControl>
