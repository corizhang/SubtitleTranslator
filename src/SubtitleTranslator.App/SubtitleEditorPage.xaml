<UserControl x:Class="SubtitleTranslator.App.SubtitleEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource AppBackgroundBrush}" Loaded="Page_OnLoaded" Unloaded="Page_OnUnloaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Click="Back_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="11,7" Margin="0,0,14,0"><ui:SymbolIcon Symbol="ArrowLeft24"/></Button><StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="ProjectTitleText" FontSize="23" FontWeight="SemiBold"/><Border Background="#ECFDF3" CornerRadius="11" Padding="9,3" Margin="12,2,0,0"><TextBlock Text="已生成" Foreground="#087A4B" FontSize="11"/></Border></StackPanel><TextBlock x:Name="SubtitlePathText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="620" Margin="0,4,0,0"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="打开视频位置" Click="OpenExternal_OnClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="保存并发布" Click="SavePublish_OnClick" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="18,16,14,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,0,10,0" ToolTip="搜索字幕正文或编号"/>
                        <ui:SymbolIcon Symbol="Search24" Foreground="{StaticResource TextSecondaryBrush}" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <TextBlock Text="搜索字幕（Ctrl+F）" Foreground="#98A2B3" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
                        <Button Content="全部" Tag="全部字幕" Click="Filter_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" MinHeight="30"/>
                        <Button Content="问题" Tag="仅问题" Click="Filter_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" MinHeight="30" Margin="6,0,0,0"/>
                        <Button Content="错误" Tag="仅错误" Click="Filter_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" MinHeight="30" Margin="6,0,0,0"/>
                        <Button Content="已修改" Tag="已修改" Click="Filter_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" MinHeight="30" Margin="6,0,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="0,2,0,10"><TextBlock Text="字幕列表" Style="{StaticResource SectionTitleStyle}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="上一问题" Click="PreviousIssue_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="9,4" MinHeight="28"/><Button Content="下一问题" Click="NextIssue_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="9,4" MinHeight="28" Margin="5,0,0,0"/></StackPanel></Grid>
                    <ListView x:Name="CueGrid" Grid.Row="3" ItemsSource="{Binding CuesView}" SelectedItem="{Binding SelectedCue}" SelectionChanged="CueGrid_OnSelectionChanged" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate><Border x:Name="CueCard" CornerRadius="7" Padding="12" Margin="0,0,4,8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Number, StringFormat=# {0}}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0"><TextBlock Text="{Binding StartText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/><TextBlock Text="  →  " Foreground="#98A2B3" FontSize="10"/><TextBlock Text="{Binding EndText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/></StackPanel><TextBlock Grid.Column="2" Text="●" ToolTip="{Binding IssueStateDisplay}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#12A36D"/><Style.Triggers><DataTrigger Binding="{Binding HasIssue}" Value="True"><Setter Property="Foreground" Value="#F79009"/></DataTrigger><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="#D92D20"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBlock Text="{Binding OriginalText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0" MaxHeight="42" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding TranslationText}" Foreground="#344054" TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="42" TextTrimming="CharacterEllipsis"/></StackPanel><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#E4E7EC"/><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Background" Value="#F5F7FF"/></DataTrigger></Style.Triggers></Style></Border.Style></Border></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid x:Name="CenterWorkspace" Grid.Column="1" Background="#F8F9FC" SizeChanged="CenterWorkspace_OnSizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="VideoFrame" Margin="16,16,16,0" Background="#0B101A" CornerRadius="9" ClipToBounds="True" MinHeight="260" MaxHeight="640">
                    <Grid><MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaOpened="MediaOpened_OnHandler" MediaFailed="MediaFailed_OnHandler"/><StackPanel x:Name="PlayerFallback" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"><ui:SymbolIcon Symbol="VideoClipOff24" Foreground="#98A2B3" FontSize="42"/><TextBlock x:Name="PlayerFallbackText" Text="正在打开视频预览……" Foreground="#D0D5DD" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/><Button Content="使用外部播放器" Click="OpenExternal_OnClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center" Margin="0,14,0,0"/></StackPanel><StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="30"><TextBlock Text="{Binding SelectedCue.OriginalText}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"><TextBlock.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9"/></TextBlock.Effect></TextBlock><TextBlock Text="{Binding SelectedCue.TranslationText}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"><TextBlock.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9"/></TextBlock.Effect></TextBlock></StackPanel></Grid>
                </Border>
                <Grid Grid.Row="1" Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PlayButton" Content="播放" Click="Play_OnClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Grid.Column="1" Content="上一条" Click="PreviousIssue_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button Grid.Column="2" Content="下一条" Click="NextIssue_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Slider x:Name="PlaybackSlider" Grid.Column="3" Margin="16,0" IsHitTestVisible="False"/><StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="PlaybackTimeText" Text="00:00:00.000" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text=" / "/><TextBlock x:Name="PlaybackDurationText" Text="00:00:00" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Grid>
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid Margin="22,14" VerticalAlignment="Top"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="当前字幕时间轴" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedCue.StartText, StringFormat=开始 {0}}" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="{Binding SelectedCue.EndText, StringFormat=结束 {0}}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/></Grid><Border Grid.Row="1" Height="6" Background="#DCE3F0" CornerRadius="3" Margin="0,18,0,0"><Border Width="10" Height="10" Background="{StaticResource PrimaryBrush}" CornerRadius="5" HorizontalAlignment="Center"/></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,34,0,0"><Button Content="‹  前 3 秒" Style="{StaticResource SecondaryButtonStyle}" Padding="18,8"/><Button Content="后 3 秒  ›" Style="{StaticResource SecondaryButtonStyle}" Padding="18,8" Margin="120,0,0,0"/></StackPanel></Grid></Border>
            </Grid>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,18,18,22"><Grid><StackPanel><TextBlock Text="{Binding SelectedCue.Number, StringFormat=当前字幕 #{0}}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding DirtyStateDisplay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="↑" Click="PreviousIssue_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" MinHeight="30"/><Button Content="↓" Click="NextIssue_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" MinHeight="30" Margin="5,0,0,0"/></StackPanel></Grid>
                    <TextBlock Text="开始时间" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SelectedCue.StartText, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="-100ms" Tag="-100" Click="NudgeStart_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="9,5" MinHeight="32"/></Grid>
                    <TextBlock Text="结束时间" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SelectedCue.EndText, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="+100ms" Tag="100" Click="NudgeEnd_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="9,5" MinHeight="32"/></Grid>
                    <TextBlock Text="原文" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,6"/><TextBox Text="{Binding SelectedCue.OriginalText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82" VerticalContentAlignment="Top"/>
                    <TextBlock Text="译文（简体中文）" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,6"/><TextBox Text="{Binding SelectedCue.TranslationText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" VerticalContentAlignment="Top"/>
                    <Border Background="#FFF8E8" BorderBrush="#F6D58D" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,16,0,0"><StackPanel><TextBlock Text="检查结果" FontWeight="SemiBold" Foreground="#B54708"/><TextBlock Text="{Binding SelectedCue.IssueStateDisplay}" Foreground="#7A4B12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid Margin="24,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="重新检查" Click="Validate_OnClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="保存" Click="Save_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button Content="保存并发布" Click="SavePublish_OnClick" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid></Border>
    </Grid>
</UserControl>
