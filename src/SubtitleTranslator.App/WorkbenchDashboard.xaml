<UserControl x:Class="SubtitleTranslator.App.WorkbenchDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:SubtitleTranslator.App"
             Background="{StaticResource Brush.Surface.App}">
    <UserControl.Resources>
        <Style x:Key="EnvironmentRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,13"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="EnvironmentIconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="{StaticResource Brush.Status.InfoSubtle}"/>
        </Style>
        <Style x:Key="ReadyDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/><Setter Property="Height" Value="7"/><Setter Property="Fill" Value="{StaticResource Brush.Status.Warning}"/>
            <Style.Triggers><DataTrigger Binding="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Fill" Value="{StaticResource Brush.Status.Success}"/></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid><Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource PageHeaderStyle}">
            <Grid Margin="34,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="工作台" Style="{StaticResource Text.PageTitle}" FontSize="32"/><StackPanel Orientation="Horizontal" Margin="24,3,0,0" VerticalAlignment="Center"><Ellipse Style="{StaticResource ReadyDotStyle}" Tag="{Binding AreResourcesReady}"/><TextBlock Text="{Binding ResourceReadinessDisplay}" Foreground="{StaticResource Brush.Status.SuccessText}" FontWeight="SemiBold" Margin="8,0,0,0"/></StackPanel></StackPanel></Grid>
        </Border>

        <ScrollViewer x:Name="WorkbenchScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="WorkbenchScroll_OnSizeChanged">
            <Grid x:Name="DashboardContentGrid" Margin="34,24,34,28"><Grid.ColumnDefinitions><ColumnDefinition Width="2.45*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="NewTaskCard" Style="{StaticResource CardStyle}" Padding="22">
                        <StackPanel><TextBlock Text="开始新的字幕任务" Style="{StaticResource Text.SectionTitle}"/>
                            <Border x:Name="DropArea" AllowDrop="True" DragEnter="DropArea_OnDragEnter" DragLeave="DropArea_OnDragLeave" Drop="DropArea_OnDrop" Margin="0,18,0,0" MinHeight="286" CornerRadius="12" Background="{StaticResource Brush.Surface.Subtle}" BorderBrush="{StaticResource Brush.Border.BrandHover}" BorderThickness="1" Padding="24">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource Brush.Border.BrandHover}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Brush.Surface.Selected}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Default}"/></Trigger></Style.Triggers></Style></Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="570">
                                    <Border Width="76" Height="64" CornerRadius="16" Background="{StaticResource Brush.Status.InfoSubtle}" HorizontalAlignment="Center"><Grid><ui:SymbolIcon Symbol="FolderOpen24" Foreground="{StaticResource Brush.Brand.Default}" FontSize="38"/><Border Width="25" Height="25" CornerRadius="13" Background="{StaticResource Brush.Brand.Default}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-4"><ui:SymbolIcon Symbol="Play24" Foreground="White" FontSize="14"/></Border></Grid></Border>
                                    <TextBlock Text="拖入视频，或选择文件" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                                    <TextBlock Text="支持 MP4、MKV、MOV、AVI、WMV、WebM、M4V" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding SelectedFilePath}" Foreground="{StaticResource Brush.Brand.Default}" TextTrimming="CharacterEllipsis" MaxWidth="540" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0"><Button Click="SelectVideo_OnClick" Style="{StaticResource PrimaryButtonStyle}" Padding="24,10"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Folder24"/><TextBlock Text=" 选择视频"/></StackPanel></Button><Button Click="OpenBatch_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="22,10" Margin="12,0,0,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Layer24"/><TextBlock Text=" 添加整季"/></StackPanel></Button></StackPanel>
                                </StackPanel>
                            </Border>
                            <Expander Header="任务偏好与交付设置" Margin="0,14,0,0" Visibility="{Binding HasSelectedFile, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="字幕内容" Style="{StaticResource Text.FieldLabel}"/><ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="源语言" Style="{StaticResource Text.FieldLabel}"/><ComboBox ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SelectedSourceLanguage}"/></StackPanel></Grid></Expander>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RecentTaskCard" Grid.Row="2" Style="{StaticResource CardStyle}" Padding="22">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><TextBlock Text="最近任务" Style="{StaticResource Text.SectionTitle}"/><Button Content="全部任务  ›" Click="OpenProjects_OnClick" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.Brand.Default}" HorizontalAlignment="Right"/></Grid>
                            <Border Grid.Row="1" Margin="0,14,0,0" Padding="0,14,0,10" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="118"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions><TextBlock Text="任务" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Grid.Column="1" Text="进度" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Grid.Column="2" Text="状态" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Grid.Column="3" Text="更新时间" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Grid.Column="4" Text="操作" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}"/></Grid></Border>
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding RecentProjects}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="0,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="118"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource Brush.Status.InfoSubtle}"><ui:SymbolIcon Symbol="VideoClip24" Foreground="{StaticResource Brush.Brand.Default}" FontSize="22"/></Border><StackPanel Margin="11,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MediaDetails}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel><local:TaskProgressIndicator Grid.Column="1" Progress="{Binding ProgressPercent}" Margin="0,0,14,0" VerticalAlignment="Center"/><Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource Brush.Surface.Info}" CornerRadius="6" Padding="7,4"><TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.Brand.Default}" FontSize="11"/></Border><TextBlock Grid.Column="3" Text="{Binding UpdatedDisplay}" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" FontSize="11"/><Button Grid.Column="4" Content="{Binding ActionText}" Tag="{Binding}" Click="Resume_OnClick" Style="{StaticResource CompactButtonStyle}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Grid.Row="3" Text="提示：任务会自动保存进度，可随时从项目库恢复。" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" Margin="0,13,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="EnvironmentCard" Style="{StaticResource CardStyle}" Padding="22"><StackPanel><Grid><TextBlock Text="运行环境" Style="{StaticResource Text.SectionTitle}"/><Border HorizontalAlignment="Right" Background="{StaticResource Brush.Status.SuccessSubtle}" CornerRadius="11" Padding="9,4"><TextBlock Text="{Binding ReadyResourceCount, StringFormat=已就绪 {0}/6}" Foreground="{StaticResource Brush.Status.SuccessText}" FontSize="11"/></Border></Grid>
                        <Border Style="{StaticResource EnvironmentRowStyle}" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource EnvironmentIconTileStyle}" Background="{StaticResource Brush.Environment.GpuSurface}"><ui:SymbolIcon Symbol="Video24" Foreground="{StaticResource Brush.Environment.GpuIcon}" FontSize="23"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="显卡与计算设备" FontWeight="SemiBold"/><TextBlock Text="{Binding GpuNameDisplay}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding GpuDetailDisplay}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis"/></StackPanel><Ellipse Grid.Column="2" Style="{StaticResource ReadyDotStyle}" Tag="{Binding GpuReady}" VerticalAlignment="Center"/></Grid></Border>
                        <Border Style="{StaticResource EnvironmentRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource EnvironmentIconTileStyle}"><ui:SymbolIcon Symbol="VideoClip24" Foreground="{StaticResource Brush.Brand.Default}" FontSize="23"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="FFmpeg" FontWeight="SemiBold"/><TextBlock Text="{Binding FfmpegStatus}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis"/></StackPanel><Ellipse Grid.Column="2" Style="{StaticResource ReadyDotStyle}" Tag="{Binding FfmpegReady}" VerticalAlignment="Center"/></Grid></Border>
                        <Border Style="{StaticResource EnvironmentRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource EnvironmentIconTileStyle}" Background="{StaticResource Brush.Environment.ProbeSurface}"><ui:SymbolIcon Symbol="Search24" Foreground="{StaticResource Brush.Environment.ProbeIcon}" FontSize="23"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="FFprobe" FontWeight="SemiBold"/><TextBlock Text="{Binding FfprobeStatus}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis"/></StackPanel><Ellipse Grid.Column="2" Style="{StaticResource ReadyDotStyle}" Tag="{Binding FfprobeReady}" VerticalAlignment="Center"/></Grid></Border>
                        <Border Style="{StaticResource EnvironmentRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource EnvironmentIconTileStyle}" Background="{StaticResource Brush.Environment.ModelSurface}"><ui:SymbolIcon Symbol="BrainCircuit24" Foreground="{StaticResource Brush.Environment.ModelIcon}" FontSize="23"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Whisper 模型" FontWeight="SemiBold"/><TextBlock Text="{Binding WhisperModelNameDisplay}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis"/></StackPanel><Ellipse Grid.Column="2" Style="{StaticResource ReadyDotStyle}" Tag="{Binding WhisperModelReady}" VerticalAlignment="Center"/></Grid></Border>
                        <Border Style="{StaticResource EnvironmentRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource EnvironmentIconTileStyle}" Background="{StaticResource Brush.Environment.RuntimeSurface}"><ui:SymbolIcon Symbol="Box24" Foreground="{StaticResource Brush.Environment.RuntimeIcon}" FontSize="23"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Whisper Runtime" FontWeight="SemiBold"/><TextBlock Text="{Binding RuntimeStatus}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis"/></StackPanel><Ellipse Grid.Column="2" Style="{StaticResource ReadyDotStyle}" Tag="{Binding RuntimeReady}" VerticalAlignment="Center"/></Grid></Border>
                        <Border Style="{StaticResource EnvironmentRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource EnvironmentIconTileStyle}" Background="{StaticResource Brush.Environment.GpuSurface}"><ui:SymbolIcon Symbol="Mic24" Foreground="{StaticResource Brush.Environment.GpuIcon}" FontSize="23"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Silero VAD" FontWeight="SemiBold"/><TextBlock Text="{Binding VadStatus}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis"/></StackPanel><Ellipse Grid.Column="2" Style="{StaticResource ReadyDotStyle}" Tag="{Binding VadReady}" VerticalAlignment="Center"/></Grid></Border>
                        <Border Style="{StaticResource EnvironmentRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource EnvironmentIconTileStyle}" Background="{StaticResource Brush.Environment.TranslationSurface}"><ui:SymbolIcon Symbol="Translate24" Foreground="{StaticResource Brush.Environment.TranslationIcon}" FontSize="23"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="DeepSeek 翻译" FontWeight="SemiBold"/><TextBlock Text="{Binding ApiKeyStatus}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis"/></StackPanel><Ellipse Grid.Column="2" Style="{StaticResource ReadyDotStyle}" Tag="{Binding HasSavedApiKey}" VerticalAlignment="Center"/></Grid></Border>
                        <Border Style="{StaticResource EnvironmentRowStyle}" BorderThickness="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource EnvironmentIconTileStyle}" Background="{StaticResource Brush.Environment.OptionalSurface}"><ui:SymbolIcon Symbol="PlayCircle24" Foreground="{StaticResource Brush.Environment.OptionalIcon}" FontSize="23"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="VLC 预览引擎" FontWeight="SemiBold"/><TextBlock Text="{Binding VlcStatus}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis"/></StackPanel><Ellipse Grid.Column="2" Style="{StaticResource ReadyDotStyle}" Tag="{Binding VlcReady}" VerticalAlignment="Center"/></Grid></Border>
                        <Button Content="环境设置  ›" Click="OpenResources_OnClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
                    </StackPanel></Border>

                    <Border x:Name="StorageCard" Grid.Row="2" Style="{StaticResource CardStyle}" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="存储空间" Style="{StaticResource Text.SectionTitle}"/><Grid Grid.Row="1" Margin="0,16,0,0"><TextBlock Text="项目目录" FontWeight="SemiBold"/><Button Content="更改" Click="OpenResources_OnClick" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.Brand.Default}" Padding="4"/></Grid><TextBlock Grid.Row="2" Text="{Binding ProjectStoragePath}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" TextAlignment="Left" Margin="0,7,0,0"/><ProgressBar Grid.Row="3" Value="{Binding ProjectDriveUsagePercent, Mode=OneWay}" Height="10" Margin="0,16,0,0"/><TextBlock Grid.Row="4" Text="{Binding ProjectStorageSummary}" Style="{StaticResource Text.Meta}" Margin="0,8,0,0" VerticalAlignment="Top"/><Button Grid.Row="5" Click="OpenProjectsFolder_OnClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ui:SymbolIcon Symbol="FolderOpen24"/><TextBlock Text=" 打开目录"/></StackPanel></Button></Grid></Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource PageFooterStyle}" Padding="28,12" Visibility="{Binding HasActiveWorkbenchTask, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding CurrentStage}" FontWeight="SemiBold"/><TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource Brush.Status.Danger}" FontSize="11"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消任务" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Content="开始生成字幕" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" Margin="10,0,0,0" Visibility="{Binding HasSelectedFile, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></Grid></Border>
    </Grid>
</UserControl>
