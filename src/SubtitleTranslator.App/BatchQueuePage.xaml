<UserControl x:Class="SubtitleTranslator.App.BatchQueuePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Background="{StaticResource Brush.Surface.App}" Loaded="Page_OnLoaded" AllowDrop="True" DragEnter="Page_OnDragEnter" Drop="Page_OnDrop">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="{StaticResource Size.Header.Feature}"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource PageHeaderStyle}">
            <Grid Margin="30,0">
                <StackPanel VerticalAlignment="Center"><TextBlock Text="当前批次" Style="{StaticResource Text.PageTitle}"/><TextBlock Text="管理本批次的等待、运行与失败项；完成成果统一进入项目库" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="Add_OnClick" Style="{StaticResource SecondaryButtonStyle}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="VideoAdd24" Margin="0,0,7,0"/><TextBlock Text="添加视频"/></StackPanel></Button>
                    <Button Click="AddFolder_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderAdd24" Margin="0,0,7,0"/><TextBlock Text="添加文件夹"/></StackPanel></Button>
                    <Button Content="重新预检" Click="Preflight_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" IsEnabled="{Binding CanEdit}"/>
                    <Button Content="归档并新建" Click="Archive_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" IsEnabled="{Binding CanArchive}"/>
                    <Button Content="开始队列" Click="Start_OnClick" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" IsEnabled="{Binding CanEdit}"/>
                </StackPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="1" Margin="30,12,30,12" BorderThickness="0" Background="Transparent">
          <TabItem Header="当前批次">
          <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <UniformGrid Columns="4">
                <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,12,0"><Grid><StackPanel><TextBlock Text="任务总数" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding TotalCount}" FontSize="{StaticResource Font.Size.Kpi}" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><ui:SymbolIcon Symbol="List24" Foreground="{StaticResource Brush.Icon.Neutral}" FontSize="{StaticResource Font.Size.Kpi}" HorizontalAlignment="Right"/></Grid></Border>
                <Border Style="{StaticResource SummaryCardStyle}" Margin="4,0,8,0"><Grid><StackPanel><TextBlock Text="可开始" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding ReadyCount}" FontSize="{StaticResource Font.Size.Kpi}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.SuccessTextStrong}" Margin="0,5,0,0"/></StackPanel><ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource Brush.Status.SuccessIcon}" FontSize="{StaticResource Font.Size.Kpi}" HorizontalAlignment="Right"/></Grid></Border>
                <Border Style="{StaticResource SummaryCardStyle}" Margin="8,0,4,0"><Grid><StackPanel><TextBlock Text="需处理" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding NeedsAttentionCount}" FontSize="{StaticResource Font.Size.Kpi}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.WarningText}" Margin="0,5,0,0"/></StackPanel><ui:SymbolIcon Symbol="Warning24" Foreground="{StaticResource Brush.Status.WarningIcon}" FontSize="{StaticResource Font.Size.Kpi}" HorizontalAlignment="Right"/></Grid></Border>
                <Border Style="{StaticResource SummaryCardStyle}" Margin="12,0,0,0"><Grid><StackPanel><TextBlock Text="已完成" Foreground="{StaticResource Brush.Text.Secondary}"/><TextBlock Text="{Binding CompletedCount}" FontSize="{StaticResource Font.Size.Kpi}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Brand.Default}" Margin="0,5,0,0"/></StackPanel><ui:SymbolIcon Symbol="DocumentCheckmark24" Foreground="{StaticResource Brush.Brand.Default}" FontSize="{StaticResource Font.Size.Kpi}" HorizontalAlignment="Right"/></Grid></Border>
            </UniformGrid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="{StaticResource Size.Inspector.Default}"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="18,0"><StackPanel VerticalAlignment="Center"><TextBox Text="{Binding CurrentBatchName, UpdateSourceTrigger=LostFocus}" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="0" MaxWidth="300" HorizontalAlignment="Left"/><TextBlock Text="{Binding CurrentBatchCreatedDisplay, StringFormat=创建于 {0}}" Style="{StaticResource Text.Meta}" Margin="0,3,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><CheckBox Content="隐藏已完成" IsChecked="{Binding HideCompleted}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="清除已完成" Click="ClearCompleted_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" MinHeight="30" IsEnabled="{Binding CanClearCompleted}"/><Button Content="移除选中" Click="Remove_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" MinHeight="30" Margin="8,0,0,0" IsEnabled="{Binding CanEdit}"/></StackPanel></Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="Horizontal" RowHeight="54" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="视频" Width="2.2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FileSizeDisplay}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="10" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="预检" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Left"><TextBlock Text="{Binding PreflightDisplay}" FontSize="{StaticResource Font.Size.Meta}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="状态" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StateDisplay}" Foreground="{StaticResource Brush.Brand.Default}" FontWeight="SemiBold" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="进度" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Center" Margin="0,0,12,0"><ProgressBar Value="{Binding Progress}" Maximum="100" Height="7"/><TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Margin="0,12,0,0" FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="当前阶段 / 结果" Binding="{Binding OutcomeDisplay}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="任务检查器" Style="{StaticResource Text.SectionTitle}"/>
                        <Border Width="44" Height="44" CornerRadius="{StaticResource Radius.Panel}" Background="{StaticResource Brush.Surface.Info}" HorizontalAlignment="Left" Margin="0,18,0,10"><ui:SymbolIcon Symbol="VideoClip24" Foreground="{StaticResource Brush.Brand.Default}" FontSize="{StaticResource Font.Size.EditorTitle}"/></Border>
                        <TextBlock Text="{Binding SelectedItem.Name, TargetNullValue=请选择队列中的任务}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedItem.MediaPath}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" FontSize="10" Margin="0,5,0,18"/>
                        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="预检结果" Style="{StaticResource Text.FieldLabel}"/><TextBlock Text="{Binding SelectedItem.PreflightDisplay}" Foreground="{StaticResource Brush.Status.SuccessTextStrong}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="任务状态" Style="{StaticResource Text.FieldLabel}"/><TextBlock Text="{Binding SelectedItem.StateDisplay}" Foreground="{StaticResource Brush.Brand.Default}" FontWeight="SemiBold"/></StackPanel></Grid>
                        <TextBlock Text="当前阶段 / 结果" Style="{StaticResource Text.FieldLabel}"/><TextBlock Text="{Binding SelectedItem.OutcomeDisplay}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <TextBlock Text="字幕输出" Style="{StaticResource Text.FieldLabel}"/><TextBlock Text="{Binding SelectedItem.SubtitlePath, TargetNullValue=尚未生成}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" FontSize="11"/>
                        <Border Background="{StaticResource Brush.Surface.Danger}" CornerRadius="{StaticResource Radius.Control}" Padding="11" Margin="0,16,0,0"><TextBlock Text="{Binding SelectedItem.Error, TargetNullValue=没有需要处理的问题}" Foreground="{StaticResource Brush.Status.Danger}" TextWrapping="Wrap" MinHeight="18"/></Border>
                        <Button Content="{Binding SelectedItem.PrimaryActionText}" Click="OpenResult_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,18,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>
          </Grid>
          </TabItem>
          <TabItem Header="历史批次">
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="42*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="58*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="18,0"><TextBlock Text="历史批次" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center"/><TextBlock Text="{Binding HistoryCount, StringFormat=共 {0} 个}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Text.Meta}"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding Archives}" SelectedItem="{Binding SelectedArchive}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="16,14"><StackPanel><Grid><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ResultDisplay}" HorizontalAlignment="Right" Foreground="{StaticResource Brush.Brand.Default}"/></Grid><TextBlock Text="{Binding SummaryDisplay}" Style="{StaticResource Text.Meta}" Margin="0,6,0,0"/><TextBlock Text="{Binding ArchivedDisplay, StringFormat=归档于 {0}}" Style="{StaticResource Text.Meta}" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions><StackPanel Margin="20,14"><TextBlock Text="{Binding SelectedArchive.Name, TargetNullValue=选择一个历史批次}" Style="{StaticResource Text.SectionTitle}"/><TextBlock Text="{Binding SelectedArchive.SummaryDisplay}" Style="{StaticResource Text.Meta}" Margin="0,6,0,0"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding SelectedArchive.Items}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="视频" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="结果" Binding="{Binding StateDisplay}" Width="90"/><DataGridTextColumn Header="最终阶段" Binding="{Binding Stage}" Width="1.4*"/><DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="1.4*"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="16,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="失败项创建新批次" Click="RecreateFailed_OnClick" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="全部重新创建" Click="RecreateAll_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button Content="查看项目库" Click="OpenProjects_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel><Button Content="删除记录" Click="DeleteArchive_OnClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></Grid></Border>
            </Grid>
          </TabItem>
        </TabControl>
        <Border Grid.Row="2" Style="{StaticResource PageFooterStyle}" Padding="24,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Message}" Foreground="{StaticResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis"/><ProgressBar Value="{Binding QueueProgress, Mode=OneWay}" Height="5" Margin="0,7,0,0"/></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding QueueProgressDisplay, StringFormat=队列总进度  {0}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="从断点重试失败项" ToolTip="重新进入处理流水线，并自动跳过已有有效缓存的阶段" Click="Retry_OnClick" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanEdit}"/><Button Content="停止队列" Click="Cancel_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
