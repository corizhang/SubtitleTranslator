<UserControl x:Class="SubtitleTranslator.App.BatchQueuePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Background="{StaticResource AppBackgroundBrush}" Loaded="Page_OnLoaded" AllowDrop="True" DragEnter="Page_OnDragEnter" Drop="Page_OnDrop">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <StackPanel VerticalAlignment="Center"><TextBlock Text="批量任务" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="整季视频统一预检、顺序处理，单项失败不会中断队列" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="Add_OnClick" Style="{StaticResource SecondaryButtonStyle}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="VideoAdd24" Margin="0,0,7,0"/><TextBlock Text="添加视频"/></StackPanel></Button>
                    <Button Click="AddFolder_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderAdd24" Margin="0,0,7,0"/><TextBlock Text="添加文件夹"/></StackPanel></Button>
                    <Button Content="重新预检" Click="Preflight_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" IsEnabled="{Binding CanEdit}"/>
                    <Button Content="开始队列" Click="Start_OnClick" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" IsEnabled="{Binding CanEdit}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="30,20,30,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <UniformGrid Columns="4">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="18,14"><Grid><StackPanel><TextBlock Text="任务总数" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding TotalCount}" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><ui:SymbolIcon Symbol="List24" Foreground="#8091B2" FontSize="26" HorizontalAlignment="Right"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="4,0,8,0" Padding="18,14"><Grid><StackPanel><TextBlock Text="可开始" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding ReadyCount}" FontSize="26" FontWeight="SemiBold" Foreground="#176B47" Margin="0,5,0,0"/></StackPanel><ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#2A9D68" FontSize="26" HorizontalAlignment="Right"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="8,0,4,0" Padding="18,14"><Grid><StackPanel><TextBlock Text="需处理" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding NeedsAttentionCount}" FontSize="26" FontWeight="SemiBold" Foreground="#B54708" Margin="0,5,0,0"/></StackPanel><ui:SymbolIcon Symbol="Warning24" Foreground="#E48A31" FontSize="26" HorizontalAlignment="Right"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0" Padding="18,14"><Grid><StackPanel><TextBlock Text="已完成" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding CompletedCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,0"/></StackPanel><ui:SymbolIcon Symbol="DocumentCheckmark24" Foreground="{StaticResource PrimaryBrush}" FontSize="26" HorizontalAlignment="Right"/></Grid></Border>
            </UniformGrid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="18,0"><TextBlock Text="处理队列" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/><Button Content="移除选中" Click="Remove_OnClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,5" MinHeight="30" IsEnabled="{Binding CanEdit}"/></Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="Horizontal" RowHeight="54" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="视频" Width="2.2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FileSizeDisplay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="预检" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#F2F4F7" CornerRadius="11" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="{Binding PreflightDisplay}" FontSize="11"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="状态" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StateDisplay}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="进度" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Center" Margin="0,0,12,0"><ProgressBar Value="{Binding Progress}" Maximum="100" Height="7"/><TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Margin="0,12,0,0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="当前阶段" Binding="{Binding Stage}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="任务检查器" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Width="44" Height="44" CornerRadius="10" Background="#EEF3FF" HorizontalAlignment="Left" Margin="0,18,0,10"><ui:SymbolIcon Symbol="VideoClip24" Foreground="{StaticResource PrimaryBrush}" FontSize="23"/></Border>
                        <TextBlock Text="{Binding SelectedItem.Name, TargetNullValue=请选择队列中的任务}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedItem.MediaPath}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,5,0,18"/>
                        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="预检结果" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedItem.PreflightDisplay}" Foreground="#176B47" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="任务状态" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedItem.StateDisplay}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/></StackPanel></Grid>
                        <TextBlock Text="当前阶段" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedItem.Stage}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <TextBlock Text="字幕输出" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedItem.SubtitlePath, TargetNullValue=尚未生成}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11"/>
                        <Border Background="#FFF4ED" CornerRadius="7" Padding="11" Margin="0,16,0,0"><TextBlock Text="{Binding SelectedItem.Error, TargetNullValue=没有需要处理的问题}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MinHeight="18"/></Border>
                        <Button Content="打开字幕" Click="OpenSubtitle_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,18,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/><ProgressBar Value="{Binding QueueProgress}" Height="5" Margin="0,7,0,0"/></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding QueueProgressDisplay, StringFormat=队列总进度  {0}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="从断点重试失败项" ToolTip="重新进入处理流水线，并自动跳过已有有效缓存的阶段" Click="Retry_OnClick" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanEdit}"/><Button Content="停止队列" Click="Cancel_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
