<UserControl x:Class="SubtitleTranslator.App.BatchQueuePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}" Loaded="Page_OnLoaded" AllowDrop="True" DragEnter="Page_OnDragEnter" Drop="Page_OnDrop">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <StackPanel VerticalAlignment="Center"><TextBlock Text="批量任务" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="整季视频按顺序处理，单项失败不会中断队列" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="添加视频" Click="Add_OnClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="移除选中" Click="Remove_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" IsEnabled="{Binding CanEdit}"/><Button Content="开始队列" Click="Start_OnClick" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" IsEnabled="{Binding CanEdit}"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="30,22,30,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="10">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="视频" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding StateDisplay}" Width="78"/>
                        <DataGridTemplateColumn Header="进度" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="4"><ProgressBar Value="{Binding Progress}" Maximum="100" Height="7"/><TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Margin="0,-7,0,0" FontSize="10"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="1.7*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="任务详情" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{Binding SelectedItem.Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    <TextBlock Text="{Binding SelectedItem.MediaPath}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,16"/>
                    <TextBlock Text="当前状态" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding SelectedItem.StateDisplay}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="处理阶段" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,6"/><TextBlock Text="{Binding SelectedItem.Stage}" TextWrapping="Wrap"/>
                    <Border Background="#FFF4ED" CornerRadius="7" Padding="11" Margin="0,16,0,0"><TextBlock Text="{Binding SelectedItem.Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MinHeight="18"/></Border>
                    <Button Content="打开字幕" Click="OpenSubtitle_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid><TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="从断点重试失败项" ToolTip="重新进入处理流水线，并自动跳过已有有效缓存的阶段" Click="Retry_OnClick" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanEdit}"/><Button Content="停止队列" Click="Cancel_OnClick" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/></StackPanel></Grid>
        </Border>
    </Grid>
</UserControl>
