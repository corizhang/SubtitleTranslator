<UserControl x:Class="SubtitleTranslator.App.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Background="{StaticResource AppBackgroundBrush}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><Grid Margin="30,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="配置新任务默认值、字幕交付和本地数据位置" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel><Button Content="保存设置" Click="Save_OnClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid Margin="30,20,30,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <Border Style="{StaticResource CardStyle}"><StackPanel><Grid><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Subtitles24" Foreground="{StaticResource PrimaryBrush}" FontSize="24" Width="38"/><StackPanel><TextBlock Text="新任务默认偏好" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="选择视频后自动使用，仍可在工作台单独修改" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></StackPanel></StackPanel></Grid><TextBlock Text="字幕内容" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,6"/><ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}"/><TextBlock Text="源语言" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6"/><ComboBox ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SelectedSourceLanguage}"/><TextBlock Text="最终质量检查" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6"/><ComboBox ItemsSource="{Binding QualityModes}" SelectedItem="{Binding SelectedQualityMode}"/><CheckBox Content="默认启用选择性 AI 翻译 QA" IsChecked="{Binding TranslationQaEnabled}" Margin="0,16,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Database24" Foreground="{StaticResource PrimaryBrush}" FontSize="24" Width="38"/><StackPanel><TextBlock Text="本地数据与隐私" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="识别缓存和项目记录仅保存在本机" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></StackPanel></StackPanel><TextBlock Text="项目目录" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,6"/><TextBlock Text="{Binding ProjectStoragePath}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><ProgressBar Value="{Binding ProjectDriveUsagePercent, Mode=OneWay}" Height="7" Margin="0,14,0,0"/><TextBlock Text="{Binding ProjectStorageSummary}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,7,0,0"/><TextBlock Text="DeepSeek API Key 由 Windows DPAPI 加密；字幕正文只在翻译任务中发送给已配置的服务。" Foreground="#667085" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardStyle}"><StackPanel><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderArrowRight24" Foreground="{StaticResource PrimaryBrush}" FontSize="24" Width="38"/><StackPanel><TextBlock Text="字幕交付" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="决定最终字幕保存位置和文件名" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></StackPanel></StackPanel><TextBlock Text="输出位置" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,6"/><ComboBox ItemsSource="{Binding PublishLocations}" SelectedItem="{Binding SelectedPublishLocation}"/><TextBlock Text="命名策略" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6"/><ComboBox ItemsSource="{Binding NamingStrategies}" SelectedItem="{Binding SelectedNamingStrategy}"/><TextBlock Text="重名处理" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6"/><ComboBox ItemsSource="{Binding ConflictPolicies}" SelectedItem="{Binding SelectedConflictPolicy}"/><TextBlock Text="自定义命名模板" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6"/><TextBox Text="{Binding NamingTemplate, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="支持 {video-name}、{language}、{layout}、{date}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,5,0,0"/><TextBlock Text="自定义输出目录" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding CustomOutputDirectory, Mode=OneWay}" IsReadOnly="True"/><Button Grid.Column="2" Content="选择目录" Click="SelectOutputDirectory_OnClick" Style="{StaticResource SecondaryButtonStyle}"/></Grid><Border Background="#F7F9FF" BorderBrush="#D6DEFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0"><TextBlock Text="{Binding PublicationPreview, StringFormat=输出预览：{0}}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></Border></StackPanel></Border>
            </StackPanel>
        </Grid></ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="30,12"><Grid><TextBlock Text="设置保存在当前 Windows 用户目录，不会写入视频文件夹。" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/><Button Content="保存所有设置" Click="Save_OnClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/></Grid></Border>
    </Grid>
</UserControl>
