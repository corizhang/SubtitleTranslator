<UserControl x:Class="SubtitleTranslator.App.DiagnosticsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Background="{StaticResource Brush.Surface.App}" Loaded="Page_OnLoaded">
    <Grid><Grid.RowDefinitions><RowDefinition Height="{StaticResource Size.Header.Feature}"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource PageHeaderStyle}"><Grid Margin="30,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="诊断中心" Style="{StaticResource Text.PageTitle}"/><TextBlock Text="检查处理环境并生成不包含密钥和内容的支持报告" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,3,0,0"/></StackPanel><Button Click="Refresh_OnClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowClockwise24" Margin="0,0,7,0"/><TextBlock Text="重新诊断"/></StackPanel></Button></Grid></Border>
        <Grid Grid.Row="1" Margin="30,20,30,20"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <Border Style="{StaticResource CardStyle}"><StackPanel><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="{StaticResource Radius.Panel}" Background="{StaticResource Brush.Status.SuccessSubtle}"><ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource Brush.Status.Success}" FontSize="{StaticResource Font.Size.EditorTitle}"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="处理环境" Style="{StaticResource Text.SectionTitle}"/><TextBlock Text="{Binding ResourceReadinessDisplay}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,3,0,0"/></StackPanel></StackPanel><ProgressBar Value="{Binding ReadyResourceCount, Mode=OneWay}" Maximum="6" Height="7" Margin="0,16,0,0"/><TextBlock Text="{Binding EnvironmentStatus}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="硬件与推理" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding HardwareStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/><Separator Margin="0,14"/><TextBlock Text="{Binding SelfTestStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><Button Content="运行本地推理自检" Command="{Binding RunSelfTestCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="日志与支持" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="应用日志会自动轮换，可能包含错误堆栈和本地文件路径；分享前请自行确认内容。" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/><Button Content="打开日志目录" Click="OpenLogs_OnClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="18,0"><TextBlock Text="脱敏诊断报告" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="复制" Click="Copy_OnClick" Style="{StaticResource CompactButtonStyle}"/><Button Content="导出" Click="Export_OnClick" Style="{StaticResource CompactButtonStyle}" Margin="6,0,0,0"/></StackPanel></Grid><TextBox x:Name="ReportBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="18,0,18,0" FontFamily="Cascadia Mono, Consolas"/><Border Grid.Row="2" Background="{StaticResource Brush.Surface.Info}" Padding="12" Margin="18,14,18,18" CornerRadius="{StaticResource Radius.Control}"><TextBlock Text="报告不包含 API Key、视频路径、模型路径或字幕正文。" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap"/></Border></Grid></Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource PageFooterStyle}" Padding="30,12"><TextBlock x:Name="StatusText" Text="诊断报告仅在本地生成，不会自动上传。" Foreground="{StaticResource Brush.Text.Secondary}"/></Border>
    </Grid>
</UserControl>
