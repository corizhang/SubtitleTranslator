<UserControl x:Class="SubtitleTranslator.App.TaskProgressIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="24">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="10" VerticalAlignment="Center">
            <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid Height="10"><Border Background="{StaticResource Brush.Track.Default}" CornerRadius="5"/><Border x:Name="PART_Track"/><Border x:Name="PART_Indicator" Background="{StaticResource Brush.Brand.Default}" CornerRadius="5" HorizontalAlignment="Left"/></Grid></ControlTemplate></ProgressBar.Template>
        </ProgressBar>
        <TextBlock Grid.Column="1" Text="{Binding Progress, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11"/>
    </Grid>
</UserControl>
