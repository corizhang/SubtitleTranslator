<Window x:Class="SubtitleTranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 字幕翻译" Height="720" Width="1040" MinHeight="620" MinWidth="900" Closing="Window_OnClosing"
        Background="#F4F6FA" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="TextBlock" x:Key="LabelText">
            <Setter Property="Foreground" Value="#586174" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="AI 字幕翻译" FontSize="30" FontWeight="SemiBold" Foreground="#172033" />
            <TextBlock Text="本地识别音频，使用 DeepSeek 翻译并生成中文或双语字幕"
                       Margin="0,6,0,0" FontSize="14" Foreground="#667085" />
        </StackPanel>

        <Border Grid.Row="1" x:Name="DropArea" AllowDrop="True"
                DragEnter="DropArea_OnDragEnter" Drop="DropArea_OnDrop"
                BorderBrush="#8796B8" BorderThickness="1.5" CornerRadius="10"
                Background="White" Padding="24" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="将视频拖到这里" FontSize="18" FontWeight="SemiBold" Foreground="#27324A" />
                    <TextBlock Text="{Binding SelectedFileDisplay}" Margin="0,7,0,0" Foreground="#667085"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Content="选择视频" Click="SelectVideo_OnClick"
                        VerticalAlignment="Center" Background="#315EFB" Foreground="White" BorderThickness="0" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Background="White" CornerRadius="10" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="任务设置" FontSize="18" FontWeight="SemiBold" Foreground="#27324A" Margin="0,0,0,20" />

                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelText}" Text="输出字幕" />
                        <ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelText}" Text="最终质量检查" />
                        <ComboBox ItemsSource="{Binding QualityModes}" SelectedItem="{Binding SelectedQualityMode}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelText}" Text="识别模型" />
                        <ComboBox ItemsSource="{Binding SpeechModels}" SelectedItem="{Binding SelectedSpeechModel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="选择本地模型" Click="SelectModel_OnClick" Padding="12,6" />
                            <Button Content="下载所选模型" Command="{Binding DownloadModelCommand}" Padding="12,6" />
                            <Button Content="取消下载" Command="{Binding CancelModelDownloadCommand}" Padding="12,6"
                                    Visibility="{Binding IsModelDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ModelStatus}" Margin="0,6,0,0" Foreground="#667085"
                                   TextWrapping="Wrap" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ModelDownloadProgress, Mode=OneWay}"
                                     Height="5" Margin="0,6,0,0"
                                     Visibility="{Binding IsModelDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelText}" Text="翻译服务" />
                        <ComboBox ItemsSource="{Binding TranslationProviders}" SelectedItem="{Binding SelectedTranslationProvider}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <PasswordBox x:Name="DeepSeekApiKeyBox" Width="220" Padding="8,6"
                                         ToolTip="输入 DeepSeek API Key；保存后不会再次显示明文" />
                            <Button Content="保存密钥" Click="SaveApiKey_OnClick" Padding="12,6" Margin="8,0,8,0" />
                            <Button Content="删除" Command="{Binding DeleteApiKeyCommand}" Padding="12,6" />
                        </StackPanel>
                        <TextBlock Text="{Binding ApiKeyStatus}" Margin="0,6,0,0" Foreground="#667085" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="启用选择性 AI 翻译 QA" IsChecked="{Binding TranslationQaEnabled}"
                                  VerticalAlignment="Center" Margin="0,0,28,0" />
                        <TextBlock Text="自动模式只修正高置信、低风险问题；人工复核不是必需步骤。"
                                   Foreground="#667085" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Margin="0,16,0,0" Padding="12" CornerRadius="6" BorderBrush="#D0D5DD" BorderThickness="1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="运行组件" FontWeight="SemiBold" Foreground="#344054" />
                                <TextBlock Text="{Binding EnvironmentStatus}" Margin="0,6,0,0" Foreground="#667085" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding HardwareStatus}" Margin="0,5,0,0" Foreground="#667085" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelfTestStatus}" Margin="0,5,0,0" Foreground="#315EFB" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ComponentInstallStatus}" Margin="0,5,0,0" Foreground="#315EFB" TextWrapping="Wrap" />
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ComponentInstallProgress, Mode=OneWay}"
                                             Height="5" Margin="0,6,0,0"
                                             Visibility="{Binding IsComponentInstalling, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="选择 FFmpeg" Click="SelectFfmpeg_OnClick" Padding="10,5" />
                                <Button Content="选择 VAD" Click="SelectVad_OnClick" Padding="10,5" />
                                <Button Content="选择运行组件" Click="SelectRuntime_OnClick" Padding="10,5" />
                                <Button Content="重新检测" Command="{Binding RefreshEnvironmentCommand}" Padding="10,5" />
                                <Button Content="运行推理自检" Command="{Binding RunSelfTestCommand}" Padding="10,5" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,38,0,0">
                                <Button Content="FFmpeg 下载说明" Command="{Binding OpenFfmpegDownloadCommand}" Padding="10,5" />
                                <Button Content="下载 VAD" Command="{Binding InstallVadCommand}" Padding="10,5" />
                                <Button Content="安装 CPU 组件" Command="{Binding InstallCpuRuntimeCommand}" Padding="10,5" />
                                <Button Content="安装 CUDA 组件" Command="{Binding InstallCudaRuntimeCommand}" Padding="10,5" />
                                <Button Content="移除已安装组件" Click="RemoveComponents_OnClick" Padding="10,5" />
                                <Button Content="取消" Command="{Binding CancelComponentInstallCommand}" Padding="10,5"
                                        Visibility="{Binding IsComponentInstalling, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Row="4" Margin="0,22,0,0" Padding="14" CornerRadius="6" Background="#F4F7FF">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding CurrentStage}" FontWeight="SemiBold" Foreground="#344054" />
                            <TextBlock Text="{Binding OverallProgress, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Foreground="#52607A" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding OverallProgress, Mode=OneWay}" Height="8" />
                        <TextBlock Text="{Binding StatusMessage}" Margin="0,9,0,0" Foreground="#3D4B69" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="5" Margin="0,14,0,0" Padding="14" CornerRadius="6" Background="#ECFDF3"
                        Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="字幕已生成" FontWeight="SemiBold" Foreground="#166534" />
                            <TextBlock Text="{Binding ResultSubtitlePath}" Margin="0,4,12,0" Foreground="#44705A"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="打开字幕" Command="{Binding OpenSubtitleCommand}" />
                            <Button Content="打开输出文件夹" Command="{Binding OpenOutputFolderCommand}"
                                    Background="#16803C" Foreground="White" BorderThickness="0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,22,0,0">
            <TextBlock Text="{Binding ValidationMessage}" Foreground="#C53929" VerticalAlignment="Center" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="取消" MinWidth="90" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="开始生成字幕" MinWidth="150"
                    Command="{Binding StartCommand}" Background="#315EFB" Foreground="White" BorderThickness="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
