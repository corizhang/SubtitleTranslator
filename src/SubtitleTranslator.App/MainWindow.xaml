<Window x:Class="SubtitleTranslator.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 字幕翻译" Height="820" Width="1280" MinHeight="680" MinWidth="1040" Loaded="Window_OnLoaded" Closing="Window_OnClosing"
        Background="{StaticResource AppBackgroundBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBrush}">
            <Grid Margin="0,0,0,14">
                <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center"><TextBlock Text="AI" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="AI 字幕翻译" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="本地识别 · 智能翻译" Foreground="#8F9BB3" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                </Grid>
                <StackPanel Grid.Row="1">
                    <Button x:Name="WorkbenchNavigation" Style="{StaticResource SelectedNavigationButtonStyle}" Click="NavigateWorkbench_OnClick"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="18" Width="28"/><TextBlock Text="工作台" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="BatchNavigation" Style="{StaticResource NavigationButtonStyle}" Click="OpenBatchQueue_OnClick"><StackPanel Orientation="Horizontal"><TextBlock Text="☷" FontSize="17" Width="28"/><TextBlock Text="批量任务" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="ProjectsNavigation" Style="{StaticResource NavigationButtonStyle}" Click="OpenProjectHistory_OnClick"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontSize="16" Width="28"/><TextBlock Text="项目库" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="OpenResources_OnClick"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" FontSize="18" Width="28"/><TextBlock Text="资源与模型" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="OpenSettings_OnClick"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="16" Width="28"/><TextBlock Text="设置" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border Margin="16,0,16,10" Padding="12" Background="#1E2942" CornerRadius="8"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock Text="环境与组件" Foreground="#AEB8CC" FontSize="11"/></StackPanel><TextBlock Text="点击资源与模型查看" Foreground="White" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="OpenDiagnostics_OnClick"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="15" Width="28"/><TextBlock Text="诊断中心" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkbenchPage" Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="30,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="工作台" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="从视频到可用字幕，只需确认内容并开始处理" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#F2F4F7" CornerRadius="14" Padding="11,6"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock Text="本地处理环境" Foreground="#475467" FontSize="12"/></StackPanel></Border></Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="30,24,30,26"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" x:Name="DropArea" AllowDrop="True" DragEnter="DropArea_OnDragEnter" Drop="DropArea_OnDrop">
                            <StackPanel><Grid><StackPanel><TextBlock Text="新建字幕任务" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="选择单个视频，应用会自动完成识别、翻译和时间轴对齐" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel><Button Content="添加整季" Click="OpenBatchQueue_OnClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
                                <Border Background="#F7F9FF" BorderBrush="#AFC0FF" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,20,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="11" Background="#E7ECFF"><TextBlock Text="＋" Foreground="{StaticResource PrimaryBrush}" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,2,14,0"><TextBlock Text="{Binding SelectedFileDisplay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="拖放视频到这里，或从电脑中选择" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="2" Content="选择视频" Click="SelectVideo_OnClick" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"/></Grid></Border>
                                <TextBlock Text="任务偏好" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="字幕内容" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="源语言" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SelectedSourceLanguage}"/></StackPanel></Grid>
                                <StackPanel Margin="0,14,0,0"><TextBlock Text="视频音轨" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack}" DisplayMemberPath="DisplayName"/></StackPanel>
                                <Expander Header="质量与交付设置" Margin="0,18,0,0" Foreground="{StaticResource TextPrimaryBrush}"><StackPanel Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="最终质量检查" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding QualityModes}" SelectedItem="{Binding SelectedQualityMode}"/></StackPanel><CheckBox Grid.Column="2" Content="启用选择性 AI 翻译 QA" IsChecked="{Binding TranslationQaEnabled}" VerticalAlignment="Bottom" Margin="0,0,0,10"/></Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="输出位置" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding PublishLocations}" SelectedItem="{Binding SelectedPublishLocation}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="命名策略" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding NamingStrategies}" SelectedItem="{Binding SelectedNamingStrategy}"/></StackPanel></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="重名处理" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding ConflictPolicies}" SelectedItem="{Binding SelectedConflictPolicy}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="自定义命名模板" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding NamingTemplate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding CustomOutputDirectory, Mode=OneWay}" IsReadOnly="True"/><Button Grid.Column="2" Content="选择目录" Click="SelectOutputDirectory_OnClick" Style="{StaticResource SecondaryButtonStyle}"/></Grid><TextBlock Text="{Binding PublicationPreview, StringFormat=输出预览：{0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Expander>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><Grid><StackPanel><TextBlock Text="当前任务" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding CurrentStage}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><TextBlock Text="{Binding OverallProgress, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{StaticResource TextSecondaryBrush}"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding OverallProgress, Mode=OneWay}" Height="8" Margin="0,12,0,0"/><TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" Foreground="#3D4B69" TextWrapping="Wrap"/><UniformGrid Columns="5" Margin="0,18,0,0"><TextBlock Text="① 准备" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="② 识别" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="③ 翻译" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="④ 质检" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="⑤ 发布" Foreground="{StaticResource TextSecondaryBrush}"/></UniformGrid></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Background="#ECFDF3" BorderBrush="#B7E7D1" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><StackPanel><TextBlock Text="字幕已生成" FontWeight="SemiBold" Foreground="#087A4B"/><TextBlock Text="{Binding ResultSubtitlePath}" Foreground="#44705A" Margin="0,5,210,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="校订" Command="{Binding OpenSubtitleCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="打开位置" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid></Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardStyle}"><StackPanel><Grid><TextBlock Text="最近项目" Style="{StaticResource SectionTitleStyle}"/><Button Content="查看全部" Click="OpenProjectHistory_OnClick" Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" Padding="6"/></Grid><TextBlock Text="继续中断任务或查看最近生成的字幕" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,12"/><ItemsControl ItemsSource="{Binding RecentProjects}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding Status}" Foreground="{StaticResource PrimaryBrush}" FontSize="11"/><TextBlock Text="{Binding UpdatedDisplay, StringFormat= · {0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></StackPanel></StackPanel><Button Grid.Column="1" Content="继续" Tag="{Binding}" Click="ResumeRecentProject_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="11,5" MinHeight="30" Margin="10,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="这里只显示最近 5 个项目，完整记录可在项目库查看。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="交付摘要" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="字幕类型" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,4"/><TextBlock Text="{Binding SelectedOutputMode}"/><TextBlock Text="保存位置" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4"/><TextBlock Text="{Binding SelectedPublishLocation}"/><TextBlock Text="文件命名" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4"/><TextBlock Text="{Binding SelectedNamingStrategy}" TextWrapping="Wrap"/></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14"><Grid><TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="660"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消任务" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Content="开始生成字幕" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" Margin="10,0,0,0"/></StackPanel></Grid></Border>
        </Grid>
        <ContentControl x:Name="PageHost" Grid.Column="1" Visibility="Collapsed"/>
    </Grid>
</Window>
