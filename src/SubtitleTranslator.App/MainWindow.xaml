<Window x:Class="SubtitleTranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 字幕翻译" Height="720" Width="1040" MinHeight="620" MinWidth="900"
        Loaded="Window_OnLoaded" Closing="Window_OnClosing"
        Background="#F4F6FA" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="TextBlock" x:Key="LabelText">
            <Setter Property="Foreground" Value="#586174" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="AI 字幕翻译" FontSize="30" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="本地识别音频，使用 DeepSeek 翻译并生成中文或双语字幕"
                           Margin="0,6,0,0" FontSize="14" Foreground="#667085" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="批量任务" Click="OpenBatchQueue_OnClick" Background="White" BorderBrush="#B8C1D5" />
                <Button Content="项目历史" Click="OpenProjectHistory_OnClick" Background="White" BorderBrush="#B8C1D5" />
                <Button Content="配置向导" Click="OpenSetupWizard_OnClick" Background="White" BorderBrush="#B8C1D5" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" x:Name="DropArea" AllowDrop="True"
                DragEnter="DropArea_OnDragEnter" Drop="DropArea_OnDrop"
                BorderBrush="#8796B8" BorderThickness="1.5" CornerRadius="10"
                Background="White" Padding="24" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="将视频拖到这里" FontSize="18" FontWeight="SemiBold" Foreground="#27324A" />
                    <TextBlock Text="{Binding SelectedFileDisplay}" Margin="0,7,0,0" Foreground="#667085"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Content="选择视频" Click="SelectVideo_OnClick"
                        VerticalAlignment="Center" Background="#315EFB" Foreground="White" BorderThickness="0" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Background="White" CornerRadius="10" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="任务设置" FontSize="18" FontWeight="SemiBold" Foreground="#27324A" Margin="0,0,0,20" />

                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelText}" Text="输出字幕" />
                        <ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelText}" Text="最终质量检查" />
                        <ComboBox ItemsSource="{Binding QualityModes}" SelectedItem="{Binding SelectedQualityMode}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3">
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource LabelText}" Text="视频音轨" />
                            <ComboBox ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack}"
                                      DisplayMemberPath="DisplayName" ToolTip="选择需要识别的对白音轨" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource LabelText}" Text="源语言" />
                            <ComboBox ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SelectedSourceLanguage}" />
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="字幕发布" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource LabelText}" Text="输出位置"/>
                                    <ComboBox ItemsSource="{Binding PublishLocations}" SelectedItem="{Binding SelectedPublishLocation}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelText}" Text="命名策略"/>
                                    <ComboBox ItemsSource="{Binding NamingStrategies}" SelectedItem="{Binding SelectedNamingStrategy}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource LabelText}" Text="重名处理"/>
                                    <ComboBox ItemsSource="{Binding ConflictPolicies}" SelectedItem="{Binding SelectedConflictPolicy}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource LabelText}" Text="自定义目录（选择自定义目录时使用）"/>
                                    <TextBox Text="{Binding CustomOutputDirectory, Mode=OneWay}" IsReadOnly="True" Padding="8,6"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="选择目录" Click="SelectOutputDirectory_OnClick" VerticalAlignment="Bottom"/>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource LabelText}" Text="命名模板（选择自定义模板时使用）"/>
                                    <TextBox Text="{Binding NamingTemplate, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding PublicationPreview, StringFormat=预览：{0}}" Foreground="#52607A" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <TextBlock Text="变量：{video-name}、{language}、{layout}、{date}" Foreground="#98A2B3" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="启用选择性 AI 翻译 QA" IsChecked="{Binding TranslationQaEnabled}"
                                  VerticalAlignment="Center" Margin="0,0,28,0" />
                        <TextBlock Text="自动模式只修正高置信、低风险问题；人工复核不是必需步骤。"
                                   Foreground="#667085" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="模型、FFmpeg、runtime、GPU 和翻译服务请在右上角“配置向导”中管理。"
                               Foreground="#667085" Margin="0,14,0,0" />
                </StackPanel>

                <Border Grid.Row="4" Margin="0,22,0,0" Padding="14" CornerRadius="6" Background="#F4F7FF">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding CurrentStage}" FontWeight="SemiBold" Foreground="#344054" />
                            <TextBlock Text="{Binding OverallProgress, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Foreground="#52607A" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding OverallProgress, Mode=OneWay}" Height="8" />
                        <TextBlock Text="{Binding StatusMessage}" Margin="0,9,0,0" Foreground="#3D4B69" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="5" Margin="0,14,0,0" Padding="14" CornerRadius="6" Background="#ECFDF3"
                        Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="字幕已生成" FontWeight="SemiBold" Foreground="#166534" />
                            <TextBlock Text="{Binding ResultSubtitlePath}" Margin="0,4,12,0" Foreground="#44705A"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="校订字幕" Command="{Binding OpenSubtitleCommand}" />
                            <Button Content="打开输出文件夹" Command="{Binding OpenOutputFolderCommand}"
                                    Background="#16803C" Foreground="White" BorderThickness="0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ValidationMessage}" Foreground="#C53929" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxHeight="48" Margin="0,0,18,0" />
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="取消" MinWidth="90" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="开始生成字幕" MinWidth="150"
                    Command="{Binding StartCommand}" Background="#315EFB" Foreground="White" BorderThickness="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
