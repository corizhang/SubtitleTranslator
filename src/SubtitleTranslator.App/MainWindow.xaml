<ui:FluentWindow x:Class="SubtitleTranslator.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AI 字幕翻译" Height="820" Width="1280" MinHeight="680" MinWidth="1040" Loaded="Window_OnLoaded" Closing="Window_OnClosing"
        Background="{StaticResource AppBackgroundBrush}" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}">
            <Grid Margin="0,0,0,14">
                <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center"><TextBlock Text="AI" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="AI 字幕翻译" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="本地识别 · 智能翻译" Foreground="#8F9BB3" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                </Grid>
                <StackPanel Grid.Row="1">
                    <Button x:Name="WorkbenchNavigation" Style="{StaticResource SelectedNavigationButtonStyle}" Click="NavigateWorkbench_OnClick"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Home24" Width="28"/><TextBlock Text="工作台" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="BatchNavigation" Style="{StaticResource NavigationButtonStyle}" Click="OpenBatchQueue_OnClick"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="List24" Width="28"/><TextBlock Text="批量任务" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="ProjectsNavigation" Style="{StaticResource NavigationButtonStyle}" Click="OpenProjectHistory_OnClick"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Folder24" Width="28"/><TextBlock Text="项目库" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="OpenResources_OnClick"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Box24" Width="28"/><TextBlock Text="资源与模型" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="OpenSettings_OnClick"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" Width="28"/><TextBlock Text="设置" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border Margin="16,0,16,10" Padding="12" Background="#1E2942" CornerRadius="8"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock Text="环境与组件" Foreground="#AEB8CC" FontSize="11"/></StackPanel><TextBlock Text="点击资源与模型查看" Foreground="White" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="OpenDiagnostics_OnClick"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Pulse24" Width="28"/><TextBlock Text="诊断中心" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>

        <ui:TitleBar Grid.Column="1" Title="AI 字幕翻译" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"/>

        <Grid x:Name="WorkbenchPage" Grid.Column="1" Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="30,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="工作台" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="从视频到可用字幕，只需确认内容并开始处理" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#F2F4F7" CornerRadius="14" Padding="11,6"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock Text="本地处理环境" Foreground="#475467" FontSize="12"/></StackPanel></Border></Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="30,24,30,26"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" x:Name="DropArea" AllowDrop="True" DragEnter="DropArea_OnDragEnter" Drop="DropArea_OnDrop">
                            <StackPanel><Grid><StackPanel><TextBlock Text="新建字幕任务" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="选择单个视频，应用会自动完成识别、翻译和时间轴对齐" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel><Button Content="添加整季" Click="OpenBatchQueue_OnClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
                                <Border Background="#F7F9FF" BorderBrush="#8FB0FF" BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,20,0,0" MinHeight="210"><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="54" Height="54" CornerRadius="12" Background="#E7ECFF"><ui:SymbolIcon Symbol="FolderOpen24" Foreground="{StaticResource PrimaryBrush}" FontSize="28"/></Border><StackPanel Grid.Column="1" Margin="16,2,18,0"><TextBlock Text="{Binding SelectedFileDisplay}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="拖入视频，或选择本地文件" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/><TextBlock Text="支持 MKV、MP4、AVI、MOV、WMV、WebM" Foreground="#98A2B3" FontSize="10" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="2" Content="选择视频" Click="SelectVideo_OnClick" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"/></Grid></Border>
                                <TextBlock Text="任务偏好" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,8" Visibility="{Binding HasSelectedFile, Converter={StaticResource BooleanToVisibilityConverter}}"/><Grid Visibility="{Binding HasSelectedFile, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="字幕内容" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="源语言" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SelectedSourceLanguage}"/></StackPanel></Grid>
                                <StackPanel Margin="0,14,0,0" Visibility="{Binding HasSelectedFile, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="视频音轨" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack}" DisplayMemberPath="DisplayName"/></StackPanel>
                                <Expander Header="质量与交付设置" Margin="0,18,0,0" Foreground="{StaticResource TextPrimaryBrush}" Visibility="{Binding HasSelectedFile, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="最终质量检查" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding QualityModes}" SelectedItem="{Binding SelectedQualityMode}"/></StackPanel><CheckBox Grid.Column="2" Content="启用选择性 AI 翻译 QA" IsChecked="{Binding TranslationQaEnabled}" VerticalAlignment="Bottom" Margin="0,0,0,10"/></Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="输出位置" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding PublishLocations}" SelectedItem="{Binding SelectedPublishLocation}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="命名策略" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding NamingStrategies}" SelectedItem="{Binding SelectedNamingStrategy}"/></StackPanel></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="重名处理" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding ConflictPolicies}" SelectedItem="{Binding SelectedConflictPolicy}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="自定义命名模板" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding NamingTemplate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding CustomOutputDirectory, Mode=OneWay}" IsReadOnly="True"/><Button Grid.Column="2" Content="选择目录" Click="SelectOutputDirectory_OnClick" Style="{StaticResource SecondaryButtonStyle}"/></Grid><TextBlock Text="{Binding PublicationPreview, StringFormat=输出预览：{0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Expander>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><Grid><TextBlock Text="最近任务" Style="{StaticResource SectionTitleStyle}"/><Button Content="全部任务  ›" Click="OpenProjectHistory_OnClick" Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" Padding="6"/></Grid><ItemsControl ItemsSource="{Binding RecentProjects}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="2,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="105"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="VideoClip24" Foreground="#7184A7" Width="34"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourcePath}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="270"/></StackPanel></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Height="6"/><TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}" FontSize="10" HorizontalAlignment="Right"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="{Binding UpdatedDisplay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/></StackPanel><Button Grid.Column="3" Content="继续" Tag="{Binding}" Click="ResumeRecentProject_OnClick" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" MinHeight="30"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="任务会自动保存进度，完整记录可在项目库查看。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Visibility="{Binding HasActiveWorkbenchTask, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><Grid><StackPanel><TextBlock Text="当前任务" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding CurrentStage}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><TextBlock Text="{Binding OverallProgress, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{StaticResource TextSecondaryBrush}"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding OverallProgress, Mode=OneWay}" Height="8" Margin="0,12,0,0"/><TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" Foreground="#3D4B69" TextWrapping="Wrap"/><UniformGrid Columns="5" Margin="0,18,0,0"><TextBlock Text="① 准备" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="② 识别" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="③ 翻译" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="④ 质检" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="⑤ 发布" Foreground="{StaticResource TextSecondaryBrush}"/></UniformGrid></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Background="#ECFDF3" BorderBrush="#B7E7D1" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><StackPanel><TextBlock Text="字幕已生成" FontWeight="SemiBold" Foreground="#087A4B"/><TextBlock Text="{Binding ResultSubtitlePath}" Foreground="#44705A" Margin="0,5,210,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="校订" Command="{Binding OpenSubtitleCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="打开位置" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></Grid></Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="运行环境" Style="{StaticResource SectionTitleStyle}"/><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Video24" Foreground="{StaticResource PrimaryBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="图形与推理设备" FontWeight="SemiBold"/><TextBlock Text="{Binding HardwareStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid></Border><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Box24" Foreground="{StaticResource PrimaryBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="模型与组件" FontWeight="SemiBold"/><TextBlock Text="{Binding EnvironmentStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid></Border><Border Padding="0,14,0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Translate24" Foreground="{StaticResource PrimaryBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="翻译服务" FontWeight="SemiBold"/><TextBlock Text="{Binding ApiKeyStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid></Border><Button Content="环境设置" Click="OpenResources_OnClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="存储空间" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="项目目录" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,5"/><TextBlock Text="{Binding ProjectStoragePath}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><ProgressBar Value="{Binding ProjectDriveUsagePercent, Mode=OneWay}" Height="7" Margin="0,16,0,0"/><TextBlock Text="{Binding ProjectStorageSummary}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/><Button Click="OpenProjectsFolder_OnClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,8,0"/><TextBlock Text="打开项目目录"/></StackPanel></Button></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14" Visibility="{Binding HasActiveWorkbenchTask, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="660"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消任务" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Content="开始生成字幕" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" Margin="10,0,0,0" Visibility="{Binding HasSelectedFile, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></Grid></Border>
        </Grid>
        <ContentControl x:Name="PageHost" Grid.Column="1" Grid.Row="1" Visibility="Collapsed"/>
    </Grid>
</ui:FluentWindow>
