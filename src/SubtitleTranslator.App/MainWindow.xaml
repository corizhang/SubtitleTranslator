<Window x:Class="SubtitleTranslator.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 字幕翻译" Height="820" Width="1280" MinHeight="680" MinWidth="1040" Loaded="Window_OnLoaded" Closing="Window_OnClosing"
        Background="{StaticResource AppBackgroundBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBrush}">
            <Grid Margin="0,0,0,14">
                <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center"><TextBlock Text="AI" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="AI 字幕翻译" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="本地识别 · 智能翻译" Foreground="#8F9BB3" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                </Grid>
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource SelectedNavigationButtonStyle}" Click="NavigateWorkbench_OnClick"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="18" Width="28"/><TextBlock Text="工作台" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="OpenBatchQueue_OnClick"><StackPanel Orientation="Horizontal"><TextBlock Text="☷" FontSize="17" Width="28"/><TextBlock Text="批量任务" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="OpenProjectHistory_OnClick"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontSize="16" Width="28"/><TextBlock Text="项目库" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="OpenResources_OnClick"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" FontSize="18" Width="28"/><TextBlock Text="资源与模型" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="OpenSettings_OnClick"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="16" Width="28"/><TextBlock Text="设置" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border Margin="16,0,16,10" Padding="12" Background="#1E2942" CornerRadius="8"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock Text="环境与组件" Foreground="#AEB8CC" FontSize="11"/></StackPanel><TextBlock Text="点击资源与模型查看" Foreground="White" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
                    <Button Style="{StaticResource NavigationButtonStyle}" Click="OpenDiagnostics_OnClick"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="15" Width="28"/><TextBlock Text="诊断中心" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="30,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="工作台" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="开始字幕任务，或继续最近的处理进度" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#ECFDF3" CornerRadius="14" Padding="11,6"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock Text="本地处理环境" Foreground="#087A4B" FontSize="12"/></StackPanel></Border></Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30,24,30,26">
                    <Border Style="{StaticResource CardStyle}" x:Name="DropArea" AllowDrop="True" DragEnter="DropArea_OnDragEnter" Drop="DropArea_OnDrop">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="开始新的字幕任务" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="拖入视频后，本地识别对白并生成中文或双语字幕" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/><Border Background="#F8FAFF" BorderBrush="#AFC0FF" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,18,0,0"><StackPanel Orientation="Horizontal"><Border Width="44" Height="44" CornerRadius="9" Background="#E9EEFF"><TextBlock Text="▷" Foreground="{StaticResource PrimaryBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="14,2,0,0"><TextBlock Text="{Binding SelectedFileDisplay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="600"/><TextBlock Text="支持 MKV、MP4、AVI、MOV、WMV、WebM" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></StackPanel></Border></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="24,0,0,0"><Button Content="选择视频" Click="SelectVideo_OnClick" Style="{StaticResource PrimaryButtonStyle}" MinWidth="110"/><Button Content="添加整季" Click="OpenBatchQueue_OnClick" Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" Margin="10,0,0,0"/></StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,16"><TextBlock Text="任务设置" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="常用选项直接设置，高级参数可按需展开" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="字幕内容" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="视频音轨" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack}" DisplayMemberPath="DisplayName"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="源语言" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SelectedSourceLanguage}"/></StackPanel>
                            </Grid>
                            <Expander Header="高级选项" Margin="0,17,0,0" Foreground="{StaticResource TextPrimaryBrush}">
                                <StackPanel Margin="0,14,0,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="最终质量检查" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding QualityModes}" SelectedItem="{Binding SelectedQualityMode}"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"><CheckBox Content="启用选择性 AI 翻译 QA" IsChecked="{Binding TranslationQaEnabled}" VerticalAlignment="Center"/><TextBlock Text="仅修正高置信、低风险问题" Foreground="{StaticResource TextSecondaryBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel></Grid>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0"><StackPanel><TextBlock Text="字幕交付" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="输出位置" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding PublishLocations}" SelectedItem="{Binding SelectedPublishLocation}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="命名策略" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding NamingStrategies}" SelectedItem="{Binding SelectedNamingStrategy}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="重名处理" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding ConflictPolicies}" SelectedItem="{Binding SelectedConflictPolicy}"/></StackPanel></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="自定义目录" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding CustomOutputDirectory, Mode=OneWay}" IsReadOnly="True"/></StackPanel><Button Grid.Column="2" Content="选择" Click="SelectOutputDirectory_OnClick" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/><StackPanel Grid.Column="4"><TextBlock Text="自定义命名模板" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding NamingTemplate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><TextBlock Text="{Binding PublicationPreview, StringFormat=文件预览：{0}}" Foreground="#52607A" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><Grid><TextBlock Text="{Binding CurrentStage}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="{Binding OverallProgress, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Foreground="#52607A"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding OverallProgress, Mode=OneWay}" Height="8" Margin="0,10,0,0"/><TextBlock Text="{Binding StatusMessage}" Margin="0,9,0,0" Foreground="#3D4B69" TextWrapping="Wrap"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Background="#ECFDF3" BorderBrush="#B7E7D1" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><StackPanel><TextBlock Text="字幕已生成并发布" FontWeight="SemiBold" Foreground="#087A4B"/><TextBlock Text="{Binding ResultSubtitlePath}" Foreground="#44705A" Margin="0,5,240,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="校订字幕" Command="{Binding OpenSubtitleCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="打开位置" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0"/></StackPanel></Grid></Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14"><Grid><TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Content="开始生成字幕" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="145" Margin="10,0,0,0"/></StackPanel></Grid></Border>
        </Grid>
    </Grid>
</Window>
